#!/usr/bin/env bash
set -euo pipefail

# Agents' shells, and git's gh credential helper in them, inherit this PATH.
# An activated mise strips its shims from PATH and its tool paths can lack one,
# so append the shims: every mise tool (gh) still resolves, after everything the
# caller already has, without shadowing wrappers such as ~/.local/bin/pi.
shims="$HOME/.local/share/mise/shims"
[[ ":$PATH:" == *":$shims:"* ]] || PATH="$PATH:$shims"

# Ultimate reaches Claude through the Claude Code subscription only. A caller's
# API key or backend override (a project .env that mise loads, for one) makes
# pi-claude-code refuse to start, so drop every variable it treats as a conflict.
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL ANTHROPIC_FOUNDRY_API_KEY \
  CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY

# Anthropic API models (anthropic/…) cache prompts for 5 minutes unless pi-ai sees
# this; with it they cache for an hour, as claude-code always does. The hub's
# LaunchAgent, `mega start` and Rex tabs all start Ultimate through this wrapper.
export PI_CACHE_RETENTION=long

# This wrapper shadows ultimate on PATH, so run the aube-linked one by absolute path.
exec "$HOME/.local/share/aube/bin/ultimate" "$@"
