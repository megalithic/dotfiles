#!/usr/bin/env bash
set -euo pipefail

# Extensions run pinned helpers (plannotator) by name from PATH.
export PATH="$HOME/.pi/agent/bin:$PATH"

# This wrapper shadows pi on PATH, so run the real binary by absolute path.
pi_bin="$(mise which pi)"

# fnox injects API keys, then replaces itself with pi.
exec fnox exec --replace -- "$pi_bin" "$@"
