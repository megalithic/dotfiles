{
  "quietStartup": true,
  "retry": {
    "baseDelayMs": 1000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetryDelayMs": 900000
    }
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 30000
  },
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "doubleEscapeAction": "tree",
  "enableSkillCommands": true,
  "hideThinkingBlock": true,
  "steeringMode": "all",
  "followUpMode": "all",
  "treeFilterMode": "no-tools",
  "showCacheMissNotices": true,
  "defaultProjectTrust": "always",
  "fullscreenScrollbar": "always",
  "tuiMode": "fullscreen",
  "editorPaddingX": 1,
  "packages": [
    "~/code/oss/pi-extensions/packages/artifacts",
    "~/code/oss/pi-extensions/packages/ast-grep",
    "~/code/oss/pi-extensions/packages/btw",
    "~/code/oss/pi-extensions/packages/save-md",
    "~/code/oss/pi-extensions/packages/session-name",
    "~/code/oss/pi-extensions/packages/pin-last-prompt",
    "~/code/oss/pi-extensions/packages/compact-tools",
    "npm:@ff-labs/pi-fff",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:@ogulcancelik/pi-ssh-tools",
    "npm:@plannotator/pi-extension",
    "npm:@sting8k/pi-vcc",
    "npm:pi-interactive-shell",
    "npm:pi-provider-opencode-console",
    "npm:pi-rtk-optimizer",
    "npm:pi-simplify",
    "npm:pi-typesafe",
    "npm:pi-warden",
    "npm:pi-web-access",
    "git:github.com/aliou/nvim-pi",
    "git:github.com/amosblomqvist/pi-interactive-subagents",
    "git:github.com/DietrichGebert/ponytail",
    "git:github.com/christomitov/pi-elixir@fix/host-packages-peer-deps",
    "git:github.com/cloudflare/security-audit-skill"
  ],
  "enabledModels": [
    "anthropic/claude-fable-5-1",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-haiku-5-5",
    "openai-codex/gpt-6-astra",
