{
  "quietStartup": true,
  "retry": {
    "baseDelayMs": 1000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetryDelayMs": 900000
    }
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 30000
  },
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "xhigh",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "doubleEscapeAction": "tree",
  "enableSkillCommands": true,
  "hideThinkingBlock": false,
  "steeringMode": "all",
  "followUpMode": "all",
  "treeFilterMode": "no-tools",
  "showCacheMissNotices": true,
  "defaultProjectTrust": "always",
  "fullscreenScrollbar": "always",
  "tuiMode": "fullscreen",
  "editorPaddingX": 1,
  "packages": [
    "~/code/oss/pi-extensions/packages/artifacts",
    "~/code/oss/pi-extensions/packages/ast-grep",
    "~/code/oss/pi-extensions/packages/btw",
    "~/code/oss/pi-extensions/packages/save-md",
    "~/code/oss/pi-extensions/packages/session-name",
    "~/code/oss/pi-extensions/packages/pin-last-prompt",
    "~/code/oss/pi-extensions/packages/compact-tools",
    "npm:@ff-labs/pi-fff",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:@ogulcancelik/pi-ssh-tools",
    "npm:@plannotator/pi-extension",
    "npm:@sting8k/pi-vcc",
    "npm:pi-interactive-shell",
    "npm:pi-provider-opencode-console",
    "npm:pi-rtk-optimizer",
    "npm:pi-simplify",
    "npm:pi-typesafe",
    "npm:pi-warden",
    "npm:pi-web-access",
    "git:github.com/aliou/nvim-pi",
    "git:github.com/amosblomqvist/pi-interactive-subagents",
    "git:github.com/DietrichGebert/ponytail",
    "git:github.com/christomitov/pi-elixir@fix/host-packages-peer-deps"
  ],
  "enabledModels": [
    "anthropic/claude-fable-5-1",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-opus-5",
    "anthropic/claude-sonnet-5",
    "anthropic/claude-haiku-4-5",
    "openai-codex/gpt-6-1-astra",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna",
    "opencode-go-console/gpt-5.6-luna",
    "opencode-go-console/kimi-k3",
    "opencode-go-console/deepseek-v4-pro",
    "opencode-go-console/deepseek-v4-flash",
    "opencode-go-console/glm-5.3",
    "opencode-go-console/qwen3.8-max",
    "opencode-go-console/qwen3.8-plus"
  ],
  "terminal": {
    "showTerminalProgress": true,
    "imageWidthCells": 120
  },
  "shellCommandPrefix": "export GIT_MERGE_AUTOEDIT=no\nGIT_EDITOR=true\nexport GIT_SEQUENCE_EDITOR=true\nexport GIT_TERMINAL_PROMPT=0\nexport PI_TMUX_IMAGES=1",
  "observational-memory": {
    "chunkTokens": 5000,
    "chunkOverlapTokens": 0,
    "poolTargetTokens": 10000,
    "consolidateAtPoolTokens": 20000,
    "compactAtContextTokens": 100000,
    "tailTokens": 20000,
    "journeyTargetTokens": 1000,
    "observerConcurrency": 4,
    "models": {
      "observer": {
        "provider": "openai-codex",
        "id": "gpt-5.6-luna",
        "thinking": "low"
      },
      "consolidator": {
        "provider": "openai-codex",
        "id": "gpt-5.6-luna",
        "thinking": "medium"
      }
    },
    "passive": false,
    "debugLog": false
  },
  "theme": "dark",
  "lastChangelogVersion": "1.4.0"
}