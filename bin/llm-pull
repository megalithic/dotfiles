#!/usr/bin/env bash
# llm-pull — download the GGUF models the llama.cpp router serves.
#
# Each model gets its own directory under the router's --models-dir, named
# after its Pi model ID (the weights plus an mmproj for image input). MTP draft
# files go under ../drafts/<id>/, outside the scanned directory, because the
# router treats every directory there as one model; tools/llama-cpp/models.ini
# points each preset's model-draft at them. Re-running skips finished files.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: llm-pull [--dry-run] <id>... | all

Models (IDs match tools/llama-cpp/models.ini and ~/.pi/agent/models.json):
  qwen3.8-27b   unsloth/Qwen3.8-27B-GGUF          UD-Q5_K_XL + mmproj + MTP draft  (~23 GB)
  gemma4-26b    unsloth/gemma-4-26B-A4B-it-GGUF   UD-Q4_K_XL + mmproj + MTP draft  (~17 GB)
  flint-40b     unsloth/flint-GGUF                UD-Q4_K_XL                       (~23 GB)
  nomic-embed   nomic-ai/nomic-embed-text-v1.5-GGUF  Q8_0 embeddings               (~0.1 GB)

Restart the router after pulling a new model:
  launchctl kickstart -k gui/$(id -u)/dev.mise.com.megadots.llama-cpp
EOF
}

# id | repo | model files (space-separated) | MTP draft file ("" = none)
MODELS=(
  "qwen3.8-27b|unsloth/Qwen3.8-27B-GGUF|Qwen3.8-27B-UD-Q5_K_XL.gguf mmproj-F16.gguf|MTP/mtp-Qwen3.8-27B-Q4_0.gguf"
  "gemma4-26b|unsloth/gemma-4-26B-A4B-it-GGUF|gemma-4-26B-A4B-it-UD-Q4_K_XL.gguf mmproj-F16.gguf|mtp-gemma-4-26B-A4B-it.gguf"
  "flint-40b|unsloth/flint-GGUF|flint-UD-Q4_K_XL.gguf|"
  "nomic-embed|nomic-ai/nomic-embed-text-v1.5-GGUF|nomic-embed-text-v1.5.Q8_0.gguf|"
)

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/llama.cpp"
DRY_RUN=0
IDS=()
for arg in "$@"; do
  case "$arg" in
    -h | --help) usage && exit 0 ;;
    --dry-run) DRY_RUN=1 ;;
    all) for m in "${MODELS[@]}"; do IDS+=("${m%%|*}"); done ;;
    *) IDS+=("$arg") ;;
  esac
done
[[ ${#IDS[@]} -gt 0 ]] || {
  usage >&2
  exit 1
}

run() {
  printf '%q ' "$@"
  printf '\n'
  [[ $DRY_RUN -eq 1 ]] || "$@"
}

pull() {
  local id="$1" entry repo files draft
  for entry in "${MODELS[@]}"; do
    [[ "${entry%%|*}" == "$id" ]] || continue
    IFS='|' read -r _ repo files draft <<<"$entry"
    # shellcheck disable=SC2086 # files is a space-separated list
    run hf download "$repo" $files --local-dir "$DATA_DIR/models/$id"
    [[ -z "$draft" ]] || run hf download "$repo" "$draft" --local-dir "$DATA_DIR/drafts/$id"
    return 0
  done
  echo "error: unknown model '$id' (see llm-pull --help)" >&2
  return 2
}

command -v hf >/dev/null || [[ $DRY_RUN -eq 1 ]] || {
  echo "error: hf CLI not found (mise tool pipx:huggingface-hub)" >&2
  exit 127
}
for id in "${IDS[@]}"; do pull "$id"; done
