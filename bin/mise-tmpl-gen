#!/usr/bin/env bash
# Generate (or check) a language template stub in a project's .config/.
#
# Usage:
#   mise-tmpl-gen <lang>            [target-dir]   # mise stub
#   mise-tmpl-gen wt.<lang>         [target-dir]   # Worktrunk config
#   mise-tmpl-gen --check <lang|wt.<lang>> [target-dir]
#
# Templates live in $MISE_TMPL_DIR (default ~/.dotfiles/config/mise/tmpls)
# under language subdirs. The dest drops the ".local" segment so mise and
# Worktrunk file patterns match:
#   <lang>/mise.local.toml   -> <target>/.config/mise.toml
#   <lang>/wt.local.toml     -> <target>/.config/wt.toml   (Worktrunk default)
#
# Stub model: the generated mise.toml is a small stub. Tasks load from the
# dotfiles template's tasks.toml via [task_config] includes, repo-keyed env
# from env.sh via _.source, and scripts execute from the template's scripts/
# directory. Nothing behavioral is copied into the project, so template edits
# apply to every consuming repo and worktree immediately. A legacy
# .config/scripts/ directory from the old copy model is stale; --check flags
# it.
#
# wt mode also ensures <target>/.worktreeinclude lists the template's
# copy-ignored allowlist so Worktrunk's `wt step copy-ignored` seeds each
# new worktree. Entries come from <lang>/worktreeinclude when the template
# provides one (comments/blank lines ignored), otherwise the default
# .config/ + .env + .envrc trio. Additive: existing entries are never
# removed.
#
# A .config/.metadata_never_index marker is maintained so Spotlight skips the
# generated directory.
#
# --check mode: reports drift between the deployed .config/ and the template
# (and legacy leftovers) without writing anything. Exit 1 when regeneration
# or cleanup is needed. Unrecognized files are listed as notes only — project
# overrides (mise.local.toml) and unrelated content are allowed.
#
# Idempotent: byte-identical destinations are left untouched; differing
# destinations are replaced with a notice. mise configs are `mise trust`ed.
set -euo pipefail

tmpl_dir="${MISE_TMPL_DIR:-$HOME/.dotfiles/config/mise/tmpls}"

usage() {
  echo "usage: mise-tmpl-gen [--check] <lang|wt.lang> [target-dir]" >&2
  echo "languages in $tmpl_dir:" >&2
  for d in "$tmpl_dir"/*/; do
    [ -d "$d" ] || continue
    echo "  $(basename "$d")" >&2
  done
}

check=0
if [ "${1:-}" = --check ]; then
  check=1
  shift
fi

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  usage
  exit 2
fi

name="$1"
mode="mise"
lang="$name"
case "$name" in
  wt.*)
    mode="wt"
    lang="${name#wt.}"
    ;;
esac

lang_dir="$tmpl_dir/$lang"
if [ ! -d "$lang_dir" ]; then
  echo "error: unknown language '$lang' ($lang_dir not found)" >&2
  usage
  exit 1
fi

case "$mode" in
  wt)
    src="$lang_dir/wt.local.toml"
    dest_name="wt.toml"
    ;;
  *)
    src="$lang_dir/mise.local.toml"
    dest_name="mise.toml"
    ;;
esac
if [ ! -f "$src" ]; then
  echo "error: template '$src' not found" >&2
  exit 1
fi

# Template copy-ignored allowlist entries: <lang>/worktreeinclude when the
# template ships one (comments and blank lines stripped), else the default
# trio every stub needs.
worktreeinclude_entries() {
  if [ -f "$lang_dir/worktreeinclude" ]; then
    grep -v '^[[:space:]]*\(#\|$\)' "$lang_dir/worktreeinclude"
  else
    printf '%s\n' ".config/" ".env" ".envrc"
  fi
}

target="${2:-${MISE_ORIGINAL_CWD:-$PWD}}"
if [ ! -d "$target" ]; then
  echo "error: target directory '$target' does not exist" >&2
  exit 1
fi
dest_dir="$target/.config"
dest="$dest_dir/$dest_name"

# ── --check: report drift, write nothing ─────────────────────────────────
if [ "$check" -eq 1 ]; then
  rc=0
  if [ ! -f "$dest" ]; then
    echo "missing: $dest (run: mise-tmpl-gen $name $target)"
    rc=1
  elif ! cmp -s "$src" "$dest"; then
    echo "drift: $dest differs from template $src"
    rc=1
  else
    echo "up-to-date: $dest"
  fi
  if [ "$mode" = "wt" ]; then
    wi="$target/.worktreeinclude"
    while IFS= read -r entry; do
      [ -f "$wi" ] && grep -qxF "$entry" "$wi" && continue
      echo "missing worktreeinclude entry: $entry (run: mise-tmpl-gen $name $target)"
      rc=1
    done <<EOF
$(worktreeinclude_entries)
EOF
  fi
  if [ -d "$dest_dir/scripts" ]; then
    echo "stale: $dest_dir/scripts/ (legacy copy model; scripts now run from $lang_dir/scripts/)"
    rc=1
  fi
  # Unrecognized content is a note, not a failure: project overrides
  # (mise.local.toml) and unrelated project files are allowed to live here.
  for f in "$dest_dir"/* "$dest_dir"/.[!.]*; do
    [ -e "$f" ] || continue
    case "$(basename "$f")" in
      mise.toml | wt.toml | mise.lock | mise.local.toml | .metadata_never_index | scripts) ;;
      *) echo "note: unmanaged in .config/: $f" ;;
    esac
  done
  exit "$rc"
fi

mkdir -p "$dest_dir"

# copy_file SRC DEST [mode] — idempotent copy with a status notice.
copy_file() {
  local s="$1" d="$2" m="${3:-}"
  if [ -f "$d" ] && cmp -s "$s" "$d"; then
    echo "up-to-date: $d"
    return 0
  fi
  if [ -f "$d" ]; then
    echo "replacing (differs from template): $d"
  else
    echo "created: $d"
  fi
  cp "$s" "$d"
  [ -n "$m" ] && chmod "$m" "$d"
  return 0
}

copy_file "$src" "$dest"

# Spotlight opt-out marker for the generated directory.
[ -e "$dest_dir/.metadata_never_index" ] || {
  : >"$dest_dir/.metadata_never_index"
  echo "created: $dest_dir/.metadata_never_index"
}

# Legacy copy-model leftovers: scripts now execute from the dotfiles template.
if [ -d "$dest_dir/scripts" ]; then
  echo "note: $dest_dir/scripts/ is stale (scripts run from $lang_dir/scripts/ now);"
  echo "      remove it after verifying nothing project-local lives there."
fi

# wt mode: keep the .worktreeinclude allowlist in sync so copy-ignored brings
# the generated .config/ (and env files) into new worktrees. Additive only.
if [ "$mode" = "wt" ]; then
  wi="$target/.worktreeinclude"
  touch "$wi"
  wi_changed=0
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    if ! grep -qxF "$entry" "$wi"; then
      printf '%s\n' "$entry" >>"$wi"
      echo "worktreeinclude += $entry"
      wi_changed=1
    fi
  done <<EOF
$(worktreeinclude_entries)
EOF
  [ "$wi_changed" -eq 0 ] && echo "worktreeinclude up-to-date: $wi"
fi

if command -v mise >/dev/null 2>&1 && [ "$dest_name" = "mise.toml" ]; then
  mise trust "$dest" >/dev/null 2>&1 || true
fi
