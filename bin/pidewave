#!/usr/bin/python3
"""Ask the owning Pi or Ultimate to start Tidewave Inspect, or list Pi leases.

  pidewave inspect --rex-block BLOCK [--pid PID]   (Rex Cmd+Ctrl+Shift+C action)
  pidewave inspect --port PORT | --cwd PATH
  pidewave list

The pidewave Pi extension writes leases to ${PI_STATE_DIR}/pidewave/ports/<port>.json
(the Pi that gets browser prompts) and one record per interactive Pi to
pidewave/pis/<pid>.json. --rex-block finds the Pi in that block, or in the tmux
pane shown there when --pid (the block's foreground process) is a tmux client;
it may be a follower, and Inspect makes it take the port. --port and --cwd ask
the current holder. Without a live Pi target, Inspect discovers the owning
Ultimate through the sibling agents command and calls its Tidewave action.
For Rex, the block's foreground cwd is used; --cwd can override it.
Runs on the system python so a Rex key action needs no mise PATH.
"""

import argparse
import glob
import json
import os
import shutil
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request

TMUX_DIRS = [
    os.path.expanduser("~/.local/share/mise/installs/tmux/latest/bin"),
    "/opt/homebrew/bin",
    "/usr/local/bin",
]


def state_dir():
    if os.environ.get("PI_STATE_DIR"):
        return os.environ["PI_STATE_DIR"]
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(base, "pi")


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except PermissionError:
        return True
    except (OSError, TypeError):
        return False


def records(kind):
    """Lease files ("ports") or every eligible Pi ("pis"), each marked alive or not."""
    found = []
    for path in sorted(glob.glob(os.path.join(state_dir(), "pidewave", kind, "*.json"))):
        try:
            with open(path) as f:
                lease = json.load(f)
        except (OSError, ValueError):
            continue
        if isinstance(lease, dict) and isinstance(lease.get("pid"), int):
            lease["alive"] = alive(lease["pid"])
            found.append(lease)
    return found


def tmux_pane_for_client(client_pid):
    tmux = shutil.which("tmux") or next(
        (os.path.join(d, "tmux") for d in TMUX_DIRS if os.access(os.path.join(d, "tmux"), os.X_OK)), None
    )
    if not tmux:
        return None
    try:
        out = subprocess.run(
            [tmux, "list-clients", "-F", "#{client_pid}\t#{pane_id}"],
            capture_output=True, text=True, timeout=2, check=True,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    for line in out.splitlines():
        pid, _, pane = line.partition("\t")
        if pid == str(client_pid):
            return pane
    return None


def inside(child, parent):
    rel = os.path.relpath(os.path.realpath(child), os.path.realpath(parent))
    return rel == "." or not rel.startswith("..")


def pick(args):
    live = [lease for lease in records("ports") if lease["alive"]]
    if args.rex_block:
        # Any Pi in the focused block, holder or follower: Inspect makes it take the port.
        live = [seat for seat in records("pis") if seat["alive"]]
        for lease in live:
            if ((lease.get("terminal") or {}).get("rex") or {}).get("block") == args.rex_block:
                return lease
        pane = tmux_pane_for_client(args.pid) if args.pid else None
        if pane:
            for lease in live:
                if ((lease.get("terminal") or {}).get("tmux") or {}).get("pane") == pane:
                    return lease
        return None
    if args.port:
        return next((lease for lease in live if lease.get("port") == args.port), None)
    if args.cwd:
        roots = [lease for lease in live if inside(args.cwd, lease.get("root", "/nonexistent"))]
        return max(roots, key=lambda lease: len(lease["root"]), default=None)
    return None


def rex_cwd(block):
    """Rex exposes the foreground process's actual cwd, then its nearest ancestors."""
    out = subprocess.run(
        ["rex", "block", "call", "-b", block, "process"],
        capture_output=True, text=True, timeout=3, check=True,
    ).stdout
    process = json.loads(out)
    for entry in [process.get("foreground"), *(process.get("ancestors") or []), process.get("child")]:
        if isinstance(entry, dict) and entry.get("cwd"):
            return entry["cwd"]
    raise ValueError("Rex has no cwd for that block; pass --cwd alongside --rex-block")


def ultimate_inspect(args):
    cwd = args.cwd or (rex_cwd(args.rex_block) if args.rex_block and not args.port else None)
    # Resolve the deployed script's symlink before finding its sibling; the override is for offline tests.
    agents = os.environ.get("PIDEWAVE_AGENTS") or os.path.join(os.path.dirname(os.path.realpath(__file__)), "agents")
    registry = json.loads(subprocess.run(
        [agents, "--json"], capture_output=True, text=True, timeout=10, check=True,
    ).stdout)
    apps = [app for app in registry["apps"] if app.get("owner", {}).get("kind") == "ultimate"]
    if args.port:
        app = next((app for app in apps if app.get("port") == args.port), None)
    else:
        roots = [app for app in apps if cwd and app.get("root") and inside(cwd, app["root"])]
        app = max(roots, key=lambda app: len(os.path.realpath(app["root"])), default=None)
    if not app:
        print("pidewave: no live Pi or Ultimate owns a Tidewave app for that target", file=sys.stderr)
        return 3
    owner = app["owner"]
    url = owner["url"].rstrip("/")
    request = urllib.request.Request(
        url + "/api/extensions/tidewave/actions/inspect",
        data=json.dumps({"args": {"conversation": owner["conversation"]}}).encode(),
        headers={"Origin": url, "Content-Type": "application/json"}, method="POST",
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        result = json.load(response)
    if isinstance(result, dict) and (result.get("error") or result.get("isError") or result.get("ok") is False):
        raise ValueError(str(result.get("error") or result))
    outcome = result.get("result") if isinstance(result, dict) else None
    if outcome != "active":
        raise ValueError(str(outcome if outcome is not None else result))
    return 0


def control(sock_path, operation):
    request = {
        "type": "control",
        "protocol": "pi.control.v1",
        "id": "pidewave-cli-%d" % int(time.time() * 1000),
        "operation": operation,
    }
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(2)
        s.connect(sock_path)
        s.sendall((json.dumps(request) + "\n").encode())
        data = b""
        while b"\n" not in data:
            chunk = s.recv(4096)
            if not chunk:
                break
            data += chunk
    return json.loads(data.split(b"\n", 1)[0] or b"null")


def main(argv=None):
    parser = argparse.ArgumentParser(prog="pidewave")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("list")
    inspect = sub.add_parser("inspect")
    inspect.add_argument("--rex-block")
    inspect.add_argument("--pid", type=int)
    inspect.add_argument("--port", type=int)
    inspect.add_argument("--cwd")
    args = parser.parse_args(argv)

    if args.command == "list":
        print(json.dumps(records("ports"), indent=2))
        return 0

    lease = pick(args)
    if not lease:
        try:
            return ultimate_inspect(args)
        except (OSError, ValueError, KeyError, subprocess.SubprocessError, urllib.error.URLError) as error:
            print("pidewave: %s" % error, file=sys.stderr)
            return 1
    if not lease.get("socket"):
        print("pidewave: that Pi has no bridge socket", file=sys.stderr)
        return 4
    try:
        response = control(lease["socket"], "pidewave.inspect")
    except (OSError, ValueError) as error:
        print("pidewave: %s" % error, file=sys.stderr)
        return 1
    if not isinstance(response, dict) or response.get("ok") is not True:
        print("pidewave: %s" % ((response or {}).get("error") or "the Pi refused"), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
