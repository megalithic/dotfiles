#!/usr/bin/env bash
# Launchd entrypoint for notiwatchd (Notification Center watcher daemon).
# The stable binary is installed by mise/config/notiwatchd/notiwatchd-build.
set -euo pipefail

BIN="$HOME/.dotfiles/bin/notiwatchd"

# launchd provides a minimal PATH; sinks (bin/ntfy -> hs, exec rules) need
# user tool dirs.
export PATH="$HOME/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

if [[ ! -x "$BIN" ]]; then
  echo "notiwatchd-launchd: $BIN missing; run: mise run setup:notiwatchd" >&2
  exit 1
fi

exec "$BIN"
