#!/usr/bin/env bash
# notify - post a notification to notiwatchd, which applies its rules and quiet
# checks and shows it through sup (falling back to sup itself when the daemon
# is down). Only when nothing was shown (exit 1) does bin/ntfy, the old
# Hammerspoon path, get a last try. Values are passed as arguments, never code.
#
# Usage: notify -t TITLE -m MESSAGE [-u normal|high|critical] [-s SOURCE]
#               [-g GROUP] [-c CONTEXT] [-a BUNDLE] [-o URL]
# -o: a local http(s) page; clicking the toast focuses that Helium tab or opens
# it (notiwatchd post --open-tab). ntfy has no such option, so it is dropped.
set -uo pipefail

title="" message="" urgency="normal" source="" group="" context="" app="" open_tab=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -t | --title) title="${2-}" ;;
    -m | --message) message="${2-}" ;;
    -u | --urgency) urgency="${2-}" ;;
    -s | --source) source="${2-}" ;;
    -g | --group) group="${2-}" ;;
    -c | --context) context="${2-}" ;;
    -a | --app) app="${2-}" ;;
    -o | --open-tab) open_tab="${2-}" ;;
    *)
      echo "notify: unknown option $1" >&2
      exit 2
      ;;
  esac
  shift 2 || {
    echo "notify: $1 needs a value" >&2
    exit 2
  }
done

args=(post --title "$title" --body "$message" --urgency "$urgency")
[[ -n "$source" ]] && args+=(--source "$source")
[[ -n "$group" ]] && args+=(--group "$group")
[[ -n "$context" ]] && args+=(--context "$context")
[[ -n "$app" ]] && args+=(--app "$app")
[[ -n "$open_tab" ]] && args+=(--open-tab "$open_tab")

"$HOME/.local/bin/notiwatchd" "${args[@]}" >/dev/null
status=$?
# Only "nothing was shown" (1) earns ntfy's last try; a usage error (2) or
# anything unexpected is reported as is, not hidden behind ntfy.
[[ $status -eq 1 ]] || exit "$status"

fallback=(send -t "$title" -m "$message" -u "$urgency")
if [[ -n "$source" ]]; then fallback+=(-s "$source"); else fallback+=(-S); fi
exec "$HOME/bin/ntfy" "${fallback[@]}"
