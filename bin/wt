#!/usr/bin/env bash
# wt — shell-agnostic Worktrunk wrapper core.
#
# Front end for the v2 deterministic lifecycle in bin/wt-v2-lib:
#   - implicit `wt <branch>` runs resolve/setup with the canonical
#     per-worktree session presentation by default
#   - `-t cd` runs the same lifecycle then only cds the invoking shell;
#     `-t window|w` builds one 60/40 window in the current session;
#     `-t session|s` is the explicit canonical-session spelling
#   - explicit v2 commands: ensure|new|open|path|repair|prune, list --json
#   - GIT_WORKTREE id derivation ({repo}-{branch-slug}) — the single source
#     of truth, queryable via `wt id [path]` (aka `wt --worktree-id`).
#     Project mise configs call this instead of re-deriving the id.
#
# Anything else (switch, config, step, hook, plain list, help, version, ...)
# execs the raw mise-pinned Worktrunk backend untouched: no flag injection,
# no directive files, no tmux. It is the upstream escape hatch; it does not
# cd the parent shell.
#
# A child process cannot cd the parent shell or set its env, so thin
# per-shell wrappers call this script with:
#   WT_SHELL      fish|posix (env-file syntax; default posix)
#   WT_CD_FILE    script writes the final cd target path here
#   WT_ENV_FILE   script writes GIT_WORKTREE set/unset commands here
# The wrapper then cds/sources. Without those env vars the script still
# works; it prints the worktree path instead of cd-ing.

# ---- worktree-id derivation (single source of truth) ------------------------
# {repo}-{branch-slug}, repo prefix kept for the tmux session switcher.
# Both segments sanitized to [A-Za-z0-9_] (everything else → "-", repeats
# collapsed, ends trimmed), so the id — and the db names derived from it —
# only ever contain alphanumerics, underscores and dashes.
worktree_id() { # $1 = worktree path
	local br repo slug
	br="$(git -C "$1" branch --show-current 2>/dev/null)"
	[ -n "$br" ] || br="$(basename "$1")"
	repo="$(basename "$(dirname "$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)")")"
	repo="$(printf '%s' "$repo" | tr -c 'A-Za-z0-9_' '-' | sed -e 's/--*/-/g' -e 's/^-//' -e 's/-*$//')"
	slug="$(printf '%s' "$br" | tr -c 'A-Za-z0-9_' '-' | sed -e 's/--*/-/g' -e 's/^-//' -e 's/-*$//')"
	printf '%s-%s' "$repo" "$slug"
}

# `wt id [path]` / `wt --worktree-id [path]`: print the GIT_WORKTREE id and exit
# without touching Worktrunk. Consumed by project mise configs so id derivation
# lives in exactly one place. Empty output outside a linked worktree (main
# checkout) so config treats it as "no worktree". Respects a pre-set
# GIT_WORKTREE (echoes it verbatim).
if [ "${1:-}" = id ] || [ "${1:-}" = --worktree-id ]; then
	q_path="${2:-$PWD}"
	if [ -n "${GIT_WORKTREE:-}" ]; then
		printf '%s' "$GIT_WORKTREE"
		exit 0
	fi
	q_gd="$(git -C "$q_path" rev-parse --git-dir 2>/dev/null)" || exit 0
	case "$q_gd" in */worktrees/*) ;; *) exit 0 ;; esac
	worktree_id "$q_path"
	exit 0
fi

# ---- load the v2 coordinator -------------------------------------------------
# Resolve this file's real directory before sourcing. The public wrapper is
# normally reached through a ~/bin symlink.
wt_v2_script_path="${BASH_SOURCE[0]}"
if [ -L "$wt_v2_script_path" ]; then
	wt_v2_link="$(readlink "$wt_v2_script_path")"
	case "$wt_v2_link" in
	/*) wt_v2_script_path="$wt_v2_link" ;;
	*) wt_v2_script_path="${wt_v2_script_path%/*}/$wt_v2_link" ;;
	esac
fi
wt_v2_script_dir="$(cd "${wt_v2_script_path%/*}" && pwd -P)"
WT_V2_SELF="$wt_v2_script_dir/$(basename "$wt_v2_script_path")"
# shellcheck source=bin/wt-lock-lib
source "$wt_v2_script_dir/wt-lock-lib"
# shellcheck source=bin/wt-v2-lib
source "$wt_v2_script_dir/wt-v2-lib"

write_env() { # $1 = set|unset, $2 = value (for set)
	[ -n "${WT_ENV_FILE:-}" ] || return 0
	case "${WT_SHELL:-posix}" in
	fish)
		if [ "$1" = set ]; then printf "set -gx GIT_WORKTREE '%s'\n" "$2" >"$WT_ENV_FILE"; else printf 'set -ge GIT_WORKTREE\n' >"$WT_ENV_FILE"; fi
		;;
	*)
		if [ "$1" = set ]; then printf "export GIT_WORKTREE='%s'\n" "$2" >"$WT_ENV_FILE"; else printf 'unset GIT_WORKTREE\n' >"$WT_ENV_FILE"; fi
		;;
	esac
}

emit_cd() {
	if [ -n "${WT_CD_FILE:-}" ]; then printf '%s\n' "$1" >"$WT_CD_FILE"; else echo "wt: worktree at $1 (no shell wrapper active; cd manually)" >&2; fi
}

# ---- dispatch ----------------------------------------------------------------
# v2 owns targets and its explicit commands; everything else is upstream's.
case "${1:-}" in
-t | --target | -t=* | --target=*)
	wt_v2_main "$@"
	exit $?
	;;
esac
if wt_v2_wants_command "$@" || {
	case "${1:-}" in
	help | -h | --help | -V | --version | list | path | prune | repair | open | ensure | new | switch | remove | merge | select | step | hook | config | '') false ;;
	-) true ;;
	-*) false ;;
	*) true ;;
	esac
} then
	wt_v2_main "$@"
	exit $?
fi

# ---- raw upstream passthrough -------------------------------------------------
# Same pinned backend the v2 path verifies; exec'd untouched.
if ! v2_resolve_backend; then
	echo "wt: ${V2_ERROR_MESSAGE:-could not resolve pinned Worktrunk}" >&2
	exit 127
fi
exec "$V2_BACKEND" "$@"
