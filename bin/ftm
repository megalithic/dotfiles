#!/usr/bin/env bash

#
# ftm — fuzzy tmux session/layout switcher
#
# ftm [options] [SESSION_NAME | FUZZY_PATTERN]
#
# Running `ftm` with no argument opens a fuzzy-finder over recent sessions,
# pre-defined layouts, running sessions, and the top zoxide directories.
# Passing an argument switches to that session if it exists, restores its
# snapshot if present, or creates it from a layout/default.
#
# Picker ordering (top → bottom):
#   1. running MRU sessions
#   2. remaining running sessions by tmux last-attached (desc)
#   3. dim dashed divider row (enter is ignored — the picker stays open)
#   4. dead MRU entries, then zoxide dirs by frecency
#   5. remaining layouts, alphabetical
#
# Hooks (similar to wt/mise hooks): executable scripts in
# $TMUX_HOOKS (default ~/.config/tmux/hooks), one per event:
#   pre-create.sh   before a new session is built
#   post-create.sh  after a new session is built, before switching
#   post-switch.sh  after any switch/attach (including brand-new sessions)
# Each receives: $1 session name, $2 cwd (session path), $3 source
# (layout|zoxide|default|snapshot), plus FTM_EVENT/FTM_SESSION/FTM_CWD/FTM_SOURCE env.
#
# Keybinds in the picker:
#   enter   switch/create/restore from selection or typed query
#   alt-enter  force fresh creation with default layout
#   ctrl-k  snapshot and kill selected session (ctrl-x also works)
#   ctrl-r  rename selected session
#
# Dependencies: tmux, fzf (>= 0.53 for native --tmux popups), bun; zoxide optional
#

set -euo pipefail

__base="${0##*/}"
script_path="${BASH_SOURCE[0]}"
if [[ -L $script_path ]]; then
  link_target="$(readlink "$script_path")"
  if [[ $link_target == /* ]]; then script_path="$link_target"
  else script_path="${script_path%/*}/$link_target"
  fi
fi
script_dir="$(cd "${script_path%/*}" && pwd)"

TMUX="${TMUX:-}"
TMUX_LAYOUTS="${TMUX_LAYOUTS:-$HOME/.config/tmux/layouts}"
TMUX_HOOKS="${TMUX_HOOKS:-$HOME/.config/tmux/hooks}"
POPUP="false"
PI_STATE_DIR="${PI_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/pi}"
FTM_STATE_DIR="${FTM_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ftm}"
FTM_ZOXIDE_LIMIT="${FTM_ZOXIDE_LIMIT:-10}"
recent_file="$FTM_STATE_DIR/recent"

[[ -d $TMUX_LAYOUTS ]] && layouts_dir="$TMUX_LAYOUTS" || layouts_dir=""

# -- ANSI colors as literals (tput spawns a process per call)
C_RESET=$'\e[0m'
C_ITALIC=$'\e[3m'
C_MAGENTA=$'\e[35m'
C_WHITE=$'\e[38;5;255m'
C_GRAY=$'\e[38;5;245m'
C_RED=$'\e[31m'
C_GREEN=$'\e[32m'
C_BOLD=$'\e[1m'
C_DIM=$'\e[2m'

TAB=$'\t'
FTM_FRESH='__FTM_FRESH__'
# replacement for $HOME in displayed paths; a literal \~ replacement keeps the
# backslash under bash 3.2 (breaks try_session's ~ re-expansion), a variable is
# version-safe
TILDE='~'

function b64_encode() {
  [[ -n $1 ]] || { printf -- '-'; return; }
  printf '%s' "$1" | base64 | tr -d '\n'
}
function b64_decode() {
  local value
  value="$(cat)"
  [[ $value != - ]] || return 0
  if base64 -D </dev/null >/dev/null 2>&1; then printf '%s' "$value" | base64 -D
  else printf '%s' "$value" | base64 --decode
  fi
}
function valid_snapshot_name() {
  [[ -n $1 && $1 != . && $1 != .. && $1 != */* && $1 != *$'\n'* && $1 != *$'\t'* ]]
}
function snapshot_file() { printf '%s/snapshots/%s' "$FTM_STATE_DIR" "$1"; }
function foreground_command() {
  local tty="$1" line pid tpgid args
  while read -r pid tpgid args; do
    [[ $pid == "$tpgid" && -n $args ]] && { printf '%s' "$args"; return; }
  done < <(ps -t "${tty##*/}" -o pid=,tpgid=,args= 2>/dev/null || true)
  printf '%s' "${2:-}"
}

function snapshot_session() {
  local session="$1" sid path tmp w p line win_name layout active zoom cwd cmd pi_id pane_tty pane_active panes
  valid_snapshot_name "$session" || return 1
  sid="$(session_id_for "$session")" || return 0
  umask 077
  mkdir -p "$FTM_STATE_DIR/snapshots"
  chmod 700 "$FTM_STATE_DIR" "$FTM_STATE_DIR/snapshots" 2>/dev/null || true
  tmp="$(mktemp "$FTM_STATE_DIR/snapshots/.snapshot.XXXXXX")"
  path="$(tmux display-message -p -t "$sid" '#{session_path}')"
  { printf 'version%s1\n' "$TAB"
    printf 'path%s%s\n' "$TAB" "$(b64_encode "$path")"
    printf 'active%s%s\n' "$TAB" "$(tmux display-message -p -t "$sid" '#{window_index}')"
    while IFS= read -r line; do
      w="${line%%"$TAB"*}"; line="${line#*"$TAB"}"; win_name="${line%%"$TAB"*}"; line="${line#*"$TAB"}"
      layout="${line%%"$TAB"*}"; line="${line#*"$TAB"}"; active="${line%%"$TAB"*}"; zoom="${line#*"$TAB"}"
      printf 'window%s%s%s%s%s%s%s%s%s%s\n' "$TAB" "$w" "$TAB" "$(b64_encode "$win_name")" "$TAB" "$(b64_encode "$layout")" "$TAB" "$active" "$TAB" "$zoom"
      while IFS= read -r p; do
        p="${p//$TAB$TAB/$TAB-$TAB}"
        IFS=$TAB read -r _ cwd cmd pi_id pane_tty pane_active <<EOF
$p
EOF
        [[ $pi_id == - ]] && pi_id=""
        cmd="$(foreground_command "$pane_tty" "$cmd")"
        printf 'pane%s%s%s%s%s%s%s%s%s%s%s%s\n' "$TAB" "$w" "$TAB" "${p%%"$TAB"*}" "$TAB" "$(b64_encode "$cwd")" "$TAB" "$(b64_encode "$cmd")" "$TAB" "$(b64_encode "$pi_id")" "$TAB" "$pane_active"
      done < <(tmux list-panes -t "$sid:$w" -F '#{pane_index}'"$TAB"'#{pane_current_path}'"$TAB"'#{pane_current_command}'"$TAB"'#{@pi_session_id}'"$TAB"'#{pane_tty}'"$TAB"'#{pane_active}' 2>/dev/null)
    done < <(tmux list-windows -t "$sid" -F '#{window_index}'"$TAB"'#{window_name}'"$TAB"'#{window_layout}'"$TAB"'#{window_active}'"$TAB"'#{window_zoomed_flag}')
  } >"$tmp" && mv "$tmp" "$(snapshot_file "$session")"
}

function snapshot_all() {
  local line
  while IFS= read -r line; do snapshot_session "${line#* }"; done < <(tmux list-sessions -F '#{session_id} #{session_name}' 2>/dev/null || true)
}

function snapshot_value() { printf '%s' "$1" | b64_decode; }
function valid_snapshot() {
  local file="$1" kind a b c d e f w active_index=""
  local versions=0 paths=0 actives=0 window_count=0 pane_count=0
  local windows=$'\n' pane_windows=$'\n'
  while IFS=$TAB read -r kind a b c d e f; do
    case $kind in
      version)
        [[ $a == 1 ]] || return 1
        versions=$((versions + 1))
        ;;
      path)
        [[ -n $a ]] && snapshot_value "$a" >/dev/null || return 1
        paths=$((paths + 1))
        ;;
      active)
        [[ $a =~ ^[0-9]+$ ]] || return 1
        active_index="$a"
        actives=$((actives + 1))
        ;;
      window)
        [[ $a =~ ^[0-9]+$ && -n $b && -n $c && $d =~ ^[01]$ && $e =~ ^[01]$ ]] || return 1
        snapshot_value "$b" >/dev/null && snapshot_value "$c" >/dev/null || return 1
        windows+="$a"$'\n'
        window_count=$((window_count + 1))
        ;;
      pane)
        [[ $a =~ ^[0-9]+$ && $b =~ ^[0-9]+$ && -n $c && -n $d && -n $e && $f =~ ^[01]$ ]] || return 1
        snapshot_value "$c" >/dev/null && snapshot_value "$d" >/dev/null && snapshot_value "$e" >/dev/null || return 1
        pane_windows+="$a"$'\n'
        pane_count=$((pane_count + 1))
        ;;
      *) return 1 ;;
    esac
  done <"$file"
  [[ $versions == 1 && $paths == 1 && $actives == 1 && $window_count -gt 0 && $pane_count -gt 0 ]] || return 1
  [[ $windows == *$'\n'"$active_index"$'\n'* ]] || return 1
  while IFS= read -r w; do
    [[ -z $w || $pane_windows == *$'\n'"$w"$'\n'* ]] || return 1
  done <<<"$windows"
  while IFS= read -r w; do
    [[ -z $w || $windows == *$'\n'"$w"$'\n'* ]] || return 1
  done <<<"$pane_windows"
}
function discard_restored_session() {
  local sid
  sid="$(session_id_for "$1")" || return 0
  tmux kill-session -t "$sid" 2>/dev/null || true
}
function restore_snapshot() {
  local session="$1" file="$FTM_STATE_DIR/snapshots/" sid w path active first=1 win_name layout wactive zoom _idx cwd cmd pi_id pane_active pane_count pane_cwd shell pane_target window_target current_index
  local -a pane_targets=()
  valid_snapshot_name "$session" || return 1
  file="$(snapshot_file "$session")"; [[ -s $file ]] || return 1
  IFS=$TAB read -r version value <"$file"
  [[ $version == version && $value == 1 ]] || return 1
  valid_snapshot "$file" || return 1
  path=""; active=""
  while IFS=$TAB read -r kind a b c d e; do
    case $kind in
      path) path="$(snapshot_value "$a")" ;;
      active) active="$a" ;;
      window)
        w="$a"; win_name="$(snapshot_value "$b")"; layout="$(snapshot_value "$c")"; wactive="$d"; zoom="$e"
        [[ -d $path ]] || path="$HOME/code"
        [[ -d $path ]] || path="$HOME"
        if [[ $first == 1 ]]; then
          tmux new-session -d -s "$session" -n "$win_name" -c "$path" || return 1
          first=0
          sid="$(session_id_for "$session")" || { discard_restored_session "$session"; return 1; }
          window_target="$(tmux display-message -p -t "$sid" '#{window_id}')" || { discard_restored_session "$session"; return 1; }
          current_index="$(tmux display-message -p -t "$window_target" '#{window_index}')" || { discard_restored_session "$session"; return 1; }
          [[ $current_index == "$w" ]] || tmux move-window -s "$window_target" -t "$sid:$w" || { discard_restored_session "$session"; return 1; }
        else
          window_target="$(tmux new-window -d -P -F '#{window_id}' -t "$sid:$w" -n "$win_name" -c "$path")" || { discard_restored_session "$session"; return 1; }
        fi
        pane_count=0
        pane_targets=()
        while IFS=$TAB read -r pk pw _idx cwd cmd pi_id pane_active; do
          [[ $pk == pane && $pw == "$w" ]] || continue
          pane_cwd="$(snapshot_value "$cwd")"
          [[ -d $pane_cwd ]] || pane_cwd="$path"
          if [[ $pane_count == 0 ]]; then
            pane_target="$(tmux display-message -p -t "$window_target" '#{pane_id}')" || { discard_restored_session "$session"; return 1; }
            tmux respawn-pane -k -t "$pane_target" -c "$pane_cwd" || { discard_restored_session "$session"; return 1; }
          else
            pane_target="$(tmux split-window -d -P -F '#{pane_id}' -t "$window_target" -c "$pane_cwd")" || { discard_restored_session "$session"; return 1; }
          fi
          pane_targets[pane_count]="$pane_target"
          pane_count=$((pane_count + 1))
        done <"$file"
        tmux select-layout -t "$window_target" "$layout" 2>/dev/null || { discard_restored_session "$session"; return 1; }
        if [[ $wactive == 1 ]]; then
          tmux select-window -t "$window_target" || { discard_restored_session "$session"; return 1; }
        fi
        if [[ $zoom == 1 ]]; then
          tmux resize-pane -Z -t "$window_target" || { discard_restored_session "$session"; return 1; }
        fi
        pane_count=0
        while IFS=$TAB read -r pk pw _idx cwd cmd pi_id pane_active; do
          [[ $pk == pane && $pw == "$w" ]] || continue
          pane_target="${pane_targets[pane_count]}"
          pane_count=$((pane_count + 1))
          cwd="$(snapshot_value "$cwd")"; cmd="$(snapshot_value "$cmd")"; pi_id="$(snapshot_value "$pi_id")"
          [[ -d $cwd ]] || cwd="$path"
          shell="${cmd%% *}"; shell="${shell##*/}"; shell="${shell#-}"
          if [[ $pane_active == 1 ]]; then
            tmux select-pane -t "$pane_target" || { discard_restored_session "$session"; return 1; }
          fi
          case "$shell" in fish|bash|zsh|sh) continue ;; esac
          [[ -n $pi_id ]] && cmd="pi --session $pi_id"
          if [[ -n $cmd ]]; then
            tmux send-keys -t "$pane_target" "cd $(printf %q "$cwd") && $cmd" Enter || { discard_restored_session "$session"; return 1; }
          fi
        done <"$file"
        ;;
    esac
  done <"$file"
  if [[ -n $active ]]; then
    tmux select-window -t "$sid:$active" 2>/dev/null || { discard_restored_session "$session"; return 1; }
  fi
  bump_recent "$session" "$path"
  return 0
}

function __help() {
  local tmux_running fzf_found
  [[ -n $TMUX ]] && tmux_running="running" || tmux_running="not running"
  command -v fzf &>/dev/null && fzf_found="installed" || fzf_found="not installed"

  printf -- "Usage: %s [options] [SESSION_NAME | FUZZY_PATTERN]\n" "$__base"
  printf -- "\n"
  printf -- "   Options:\n"
  printf -- "     -p              Run fzf directly (already inside a tmux popup); default uses fzf --tmux\n"
  printf -- "     -h              This help text you're presently reading. 😄\n"
  printf -- "     --snapshot=NAME Save a running session snapshot\n"
  printf -- "     --snapshot-all Save snapshots for all running sessions\n"
  printf -- "\n"
  printf -- "   Deterministic (non-picker) session lifecycle:\n"
  printf -- "     %s ensure --kind worktree|generic --cwd PATH --session NAME \\\n" "$__base"
  printf -- "         [--worktree-id ID] [--lease TOKEN] [--pi-session UUID] \\\n"
  printf -- "         [--presentation cd|window|session] [--primary] \\\n"
  printf -- "         [--attach auto|never] [--format json|text]\n"
  printf -- "     %s repair ... [--restart-services]   additive repair of a recognized session\n" "$__base"
  printf -- "     %s remove --session NAME [--cwd PATH] [--discard-snapshot]\n" "$__base"
  printf -- "\n"
  printf -- "   Hooks (executable scripts in \$TMUX_HOOKS, default ~/.config/tmux/hooks):\n"
  printf -- "     pre-create.sh / post-create.sh / post-switch.sh\n"
  printf -- "     args: SESSION CWD SOURCE (layout|zoxide|default)\n"
  printf -- "\n"
  printf -- "   Dependencies:\n"
  printf -- "     tmux            (%s)\n" "$tmux_running"
  printf -- "     fzf             (%s)\n" "$fzf_found"
  printf -- "\n"

  exit 0
}

if ! command -v fzf &>/dev/null && [[ ${1:-} != --snapshot=* && ${1:-} != --snapshot-all && ${1:-} != -s &&
  ${1:-} != ensure && ${1:-} != repair && ${1:-} != remove ]]; then
  printf -- "ERROR: %s requires fzf to be installed\n" "$__base"
  __help
  # shellcheck disable=SC2317 # defensive; __help exits
  exit 1
fi

# -- strip the pi status dot and any zoxide path column (running sessions
#    render bold instead of carrying a text marker; fzf's --ansi strips the
#    styling before selections reach us)
function strip_markers() {
  local s="$1"
  s="${s%%"$TAB"*}"
  s="${s% ●}"
  s="${s% ○}"
  printf '%s' "$s"
}

# -- dim divider between running sessions and everything else: dashes sized
#    to the list. FZF_COLUMNS is exported to reload commands (ftm --list);
#    the initial call estimates from the tmux client width (popup is 70%
#    wide) minus padding/pointer/scrollbar columns.
function divider_line() {
  local cols="${FZF_COLUMNS:-0}"
  if [[ $cols -le 0 ]]; then
    cols="$(tmux display-message -p '#{client_width}' 2>/dev/null || printf 80)"
    [[ $POPUP == "true" ]] || cols=$((cols * 70 / 100))
  fi
  cols=$((cols - 6))
  [[ $cols -lt 3 ]] && cols=3
  printf '%*s' "$cols" '' | tr ' ' '-'
}

# -- resolve a session name to its id ($N). tmux target parsing mangles names
#    with a leading dot (reads it as a window separator; "=" doesn't help), so
#    every tmux command targeting an existing session goes through ids.
function session_id_for() {
  local name="$1" line
  while IFS= read -r line; do
    if [[ ${line#* } == "$name" ]]; then
      printf '%s' "${line%% *}"
      return 0
    fi
  done < <(tmux list-sessions -F '#{session_id} #{session_name}' 2>/dev/null)
  return 1
}

# -- run an event hook if present+executable. Never fails the caller.
function run_hook() {
  local event="$1" session="$2" cwd="$3" source="$4"
  local hook="$TMUX_HOOKS/$event.sh"
  [[ -x $hook ]] || return 0
  FTM_EVENT="$event" FTM_SESSION="$session" FTM_CWD="$cwd" FTM_SOURCE="$source" \
    bash "$hook" "$session" "$cwd" "$source" || true
}

# -- like run_hook but detached (nohup + backgrounded subshell): survives the
#    caller dying. Needed for post-switch — when ftm runs inside the C-Space
#    display-popup binding, switch-client collapses the popup and tmux HUPs
#    the script's process group before anything after the switch can run.
function run_hook_detached() {
  local event="$1" session="$2" cwd="$3" source="$4"
  local hook="$TMUX_HOOKS/$event.sh"
  [[ -x $hook ]] || return 0
  (FTM_EVENT="$event" FTM_SESSION="$session" FTM_CWD="$cwd" FTM_SOURCE="$source" \
    nohup bash "$hook" "$session" "$cwd" "$source" >/dev/null 2>&1 &)
}

# -- move a session to the top of the MRU state file (source of truth for
#    picker ordering); keeps the newest 50 entries. Lines are "name<TAB>cwd"
#    (cwd may be empty) so dead sessions with a live dir still render.
function bump_recent() {
  local session="$1" cwd="${2:-}" line count=0 tmp
  [[ -n $session ]] || return 0
  mkdir -p "$FTM_STATE_DIR"
  tmp="$recent_file.tmp.$$"
  {
    if [[ -n $cwd ]]; then
      printf '%s\t%s\n' "$session" "$cwd"
    else
      printf '%s\n' "$session"
    fi
    if [[ -f $recent_file ]]; then
      while IFS= read -r line; do
        [[ -z $line || ${line%%"$TAB"*} == "$session" ]] && continue
        printf '%s\n' "$line"
        count=$((count + 1))
        [[ $count -ge 49 ]] && break
      done <"$recent_file"
    fi
  } >"$tmp"
  mv "$tmp" "$recent_file"
}

# -- true when the pane tty has a process titled "pi": pi runs as a node
#    shim (pane_current_command is "node"), and its process.title is the
#    only distinguishing mark (trick from nicknisi's tmux-smart-name).
# shellcheck disable=SC2009 # pgrep can't filter by tty
function is_pi_pane() {
  ps -t "${1#/dev/}" -o comm= 2>/dev/null | grep -qx pi
}

# -- Find every live Pi pane. Manifest and status records are a union; both
#    paths still validate the pane's process title before exposing it.
function pi_panes_for() {
  local session="$1" sid="$2" f pane pid win panes
  local wname windex wpane wcmd wtty seen=$'\n' seen_windows=$'\n' _st _sess
  panes="$(tmux list-panes -s -t "$sid" -F '#{window_name}'"$TAB"'#{window_index}'"$TAB"'#{pane_id}'"$TAB"'#{pane_current_command}'"$TAB"'#{pane_tty}' 2>/dev/null || true)"
  while IFS=$TAB read -r pane pid; do
    [[ -n $pane ]] || continue
    [[ $pid =~ ^[0-9]+$ ]] && ! kill -0 "$pid" 2>/dev/null && continue
    while IFS=$TAB read -r wname windex wpane wcmd wtty; do
      if [[ $wpane == "$pane" && $wcmd == node ]] && is_pi_pane "$wtty" && [[ $seen != *$'\n'"$pane"$'\n'* ]]; then
        seen+="$pane"$'\n'
        seen_windows+="$wname"$'\n'"$windex"$'\n'
        printf '%s\n' "$pane"
        break
      fi
    done <<<"$panes"
  done < <("$script_dir/ftm-grid-preview" --manifest-panes "$session" "$PI_STATE_DIR/manifests")
  for f in "$PI_STATE_DIR/status/pi-$session-"*.status; do
    [[ -e $f ]] || continue
    win="${f##*/pi-$session-}"
    win="${win%.status}"
    IFS=' ' read -r _st pid _sess <"$f" || true
    [[ $_sess == "$session" ]] || continue
    [[ $pid =~ ^[0-9]+$ ]] && ! kill -0 "$pid" 2>/dev/null && continue
    [[ $seen_windows == *$'\n'"$win"$'\n'* ]] && continue
    while IFS=$TAB read -r wname windex wpane wcmd wtty; do
      if [[ ($wname == "$win" || $windex == "$win") && $wcmd == node ]] && is_pi_pane "$wtty" && [[ $seen != *$'\n'"$wpane"$'\n'* ]]; then
        seen+="$wpane"$'\n'
        printf '%s\n' "$wpane"
        break
      fi
    done <<<"$panes"
  done
}

# -- fzf preview stdout is a stream of complete frames; the helper owns the
#    ANSI-safe grid and refreshes it without terminal cursor control.
function preview_entry() {
  local line="$1" name path sid pane
  local -a targets=()
  if [[ $line == *"$TAB"* ]]; then
    path="${line#*"$TAB"}"
    printf '%s%s%s\n' "$C_GRAY" "$path" "$C_RESET"
    return 0
  fi
  name="$(strip_markers "$line")"
  [[ -n $name ]] || return 0
  if sid="$(session_id_for "$name")"; then
    while IFS= read -r pane; do
      [[ -n $pane ]] && targets+=("$pane")
    done < <(pi_panes_for "$name" "$sid")
    if [[ ${#targets[@]} -eq 0 ]]; then
      pane="$(tmux display-message -p -t "$sid" '#{pane_id}' 2>/dev/null || true)"
      [[ -n $pane ]] && targets+=("$pane")
    fi
    if [[ ${#targets[@]} -gt 0 ]]; then
      "$script_dir/ftm-grid-preview" "$name" "${targets[@]}"
    fi
  elif [[ -n $layouts_dir && -f "$layouts_dir/$name.sh" ]]; then
    cat "$layouts_dir/$name.sh"
  fi
  return 0
}

# -- pre-defined layout names (one glob, no subshells)
function get_layouts() {
  local f
  [[ -n $layouts_dir ]] || return 0
  for f in "$layouts_dir"/*.sh; do
    [[ -e $f ]] || continue
    f="${f##*/}"
    printf '%s\n' "${f%.sh}"
  done
}

# -- print a running-session row: bold name plus a pi status icon following
#    the common three-state agent model (workmux/fleet/claude-squad):
#      red ●    needs attention — blocked on a structured question or the
#               turn ended with an error (states asking/error)
#      green ●  actively working, no issues (state working)
#      white ○  idle — no prompt yet or turn completed cleanly (idle/done)
#    Sessions without a live pi status file render no icon.
function print_running() {
  local name="$1"
  if [[ $status_red == *$'\n'"$name"$'\n'* ]]; then
    printf '%s%s%s %s●%s\n' "$C_BOLD" "$name" "$C_RESET" "$C_RED" "$C_RESET"
  elif [[ $status_green == *$'\n'"$name"$'\n'* ]]; then
    printf '%s%s%s %s●%s\n' "$C_BOLD" "$name" "$C_RESET" "$C_GREEN" "$C_RESET"
  elif [[ $status_idle == *$'\n'"$name"$'\n'* ]]; then
    printf '%s%s%s %s○%s\n' "$C_BOLD" "$name" "$C_RESET" "$C_WHITE" "$C_RESET"
  else
    printf '%s%s%s\n' "$C_BOLD" "$name" "$C_RESET"
  fi
}

# -- annotated picker list. Running sessions render bold (non-running
#    entries — layouts and dirs — render dim), plus a
#    colored pi status dot (see print_running) sourced from the agent-status
#    extension's files ($PI_STATE_DIR/status/pi-{session}-{window}.status,
#    "state pid session"). Pure file reads + kill -0 — no subprocesses, so
#    the picker opens instantly. Zoxide entries render as "name<TAB>dimmed
#    path". Ordering: MRU file, then running sessions by last-attached, then
#    zoxide by frecency, then layouts alphabetically.
function print_list() {
  local exclude_current="${1:-}"
  local emitted=$'\n' sess_wrapped=$'\n'
  local s name path line zi mi n f st st_pid st_sess running_count=0
  local status_red=$'\n' status_green=$'\n' status_idle=$'\n'
  local -a sess_order=() zx_names=() zx_paths=() mru_names=() mru_paths=()

  # pi agent states (dead pids skipped)
  for f in "$PI_STATE_DIR/status"/pi-*.status; do
    [[ -e $f ]] || continue
    IFS=' ' read -r st st_pid st_sess <"$f" || true
    [[ -n $st_sess ]] || continue
    [[ $st_pid =~ ^[0-9]+$ ]] && ! kill -0 "$st_pid" 2>/dev/null && continue
    case $st in
    asking | error) status_red+="$st_sess"$'\n' ;;
    working) status_green+="$st_sess"$'\n' ;;
    idle | done) status_idle+="$st_sess"$'\n' ;;
    esac
  done

  # running sessions, most recently attached first
  while IFS= read -r line; do
    s="${line#* }"
    [[ -n $s ]] || continue
    sess_order+=("$s")
    sess_wrapped+="$s"$'\n'
  done < <(tmux list-sessions -F '#{session_last_attached} #{session_name}' 2>/dev/null | sort -rn)

  # top zoxide dirs by frecency
  n=0
  if command -v zoxide &>/dev/null; then
    while IFS= read -r path; do
      [[ $n -ge $FTM_ZOXIDE_LIMIT ]] && break
      [[ -d $path ]] || continue
      zx_names+=("${path##*/}")
      zx_paths+=("$path")
      n=$((n + 1))
    done < <(zoxide query -l 2>/dev/null || true)
  fi

  # MRU entries, most recent first: "name<TAB>cwd" (cwd may be empty)
  if [[ -f $recent_file ]]; then
    while IFS= read -r line; do
      [[ -n $line ]] || continue
      mru_names+=("${line%%"$TAB"*}")
      if [[ $line == *"$TAB"* ]]; then
        mru_paths+=("${line#*"$TAB"}")
      else
        mru_paths+=("")
      fi
    done <"$recent_file"
  fi

  # 1) MRU running sessions, then remaining running sessions by last-attached.
  for mi in "${!mru_names[@]}"; do
    name="${mru_names[$mi]}"
    [[ $name == "default" || $name == "$exclude_current" ]] && continue
    [[ $sess_wrapped == *$'\n'"$name"$'\n'* ]] || continue
    [[ $emitted == *$'\n'"$name"$'\n'* ]] && continue
    emitted+="$name"$'\n'
    running_count=$((running_count + 1))
    print_running "$name"
  done

  # 2) remaining running sessions by last-attached
  for name in "${sess_order[@]}"; do
    [[ $name == "default" || $name == "$exclude_current" ]] && continue
    [[ $emitted == *$'\n'"$name"$'\n'* ]] && continue
    emitted+="$name"$'\n'
    running_count=$((running_count + 1))
    print_running "$name"
  done

  [[ $running_count -gt 0 ]] && printf '%s%s%s\n' "$C_DIM" "$(divider_line)" "$C_RESET"

  # 3) dead MRU entries, then zoxide dirs and layouts.
  for mi in "${!mru_names[@]}"; do
    name="${mru_names[$mi]}"
    [[ $name == "default" || $name == "$exclude_current" ]] && continue
    [[ $emitted == *$'\n'"$name"$'\n'* ]] && continue
    if [[ -n $layouts_dir && -f "$layouts_dir/$name.sh" ]]; then
      emitted+="$name"$'\n'
      printf '%s%s%s\n' "$C_DIM" "$name" "$C_RESET"
    elif [[ -n ${mru_paths[$mi]} && -d ${mru_paths[$mi]} ]]; then
      emitted+="$name"$'\n'
      printf '%s%s%s\t%s%s%s\n' "$C_DIM" "$name" "$C_RESET" "$C_GRAY" "${mru_paths[$mi]/#$HOME/$TILDE}" "$C_RESET"
    else
      for zi in "${!zx_names[@]}"; do
        if [[ ${zx_names[$zi]} == "$name" ]]; then
          emitted+="$name"$'\n'
          printf '%s%s%s\t%s%s%s\n' "$C_DIM" "$name" "$C_RESET" "$C_GRAY" "${zx_paths[$zi]/#$HOME/$TILDE}" "$C_RESET"
          break
        fi
      done
    fi
  done

  # remaining zoxide dirs by frecency (layout name wins → deferred to 4)
  for zi in "${!zx_names[@]}"; do
    name="${zx_names[$zi]}"
    [[ -z $name || $name == "default" || $name == "$exclude_current" ]] && continue
    [[ $emitted == *$'\n'"$name"$'\n'* ]] && continue
    [[ -n $layouts_dir && -f "$layouts_dir/$name.sh" ]] && continue
    emitted+="$name"$'\n'
    printf '%s%s%s\t%s%s%s\n' "$C_DIM" "$name" "$C_RESET" "$C_GRAY" "${zx_paths[$zi]/#$HOME/$TILDE}" "$C_RESET"
  done

  # 4) remaining layouts (glob order = alphabetical)
  while IFS= read -r name; do
    [[ -z $name || $name == "default" || $name == "$exclude_current" ]] && continue
    [[ $emitted == *$'\n'"$name"$'\n'* ]] && continue
    emitted+="$name"$'\n'
    printf '%s%s%s\n' "$C_DIM" "$name" "$C_RESET"
  done < <(get_layouts)
}

# -- change to the given existing session. MRU write and the post-switch hook
#    launch happen BEFORE the switch: inside the C-Space display-popup
#    binding, switch-client collapses the popup and tmux HUPs this script, so
#    nothing after the switch is guaranteed to run.
function to_session() {
  local session sid spath
  session="$(strip_markers "$1")"
  sid="$(session_id_for "$session")" || return 1
  spath="$(tmux display-message -p -t "$sid" '#{session_path}' 2>/dev/null || true)"
  bump_recent "$session" "$spath"
  run_hook_detached post-switch "$session" "$spath" "session"
  tmux "$change" -t "$sid" ';' refresh-client
}

# -- new session with pre-defined layout, OR just new basic tmux session.
#    Fires pre-create/post-create hooks around the build.
function new_session() {
  local session="$1" cwd="$2" source="${3:-default}" sid restored_cwd

  if [[ $source != fresh && -f "$(snapshot_file "$session")" ]] && restore_snapshot "$session"; then
    sid="$(session_id_for "$session")"
    restored_cwd="$(tmux display-message -p -t "$sid" '#{session_path}' 2>/dev/null || printf '%s' "$cwd")"
    run_hook post-create "$session" "$restored_cwd" "snapshot"
    to_session "$session"
    return 0
  fi
  local force_default=0
  if [[ $source == fresh ]]; then
    source="default"
    force_default=1
  fi
  [[ $force_default == 0 && -n $layouts_dir && -f "$layouts_dir/$session.sh" ]] && source="layout"

  run_hook pre-create "$session" "$cwd" "$source"

  if [[ $source == "layout" ]]; then
    bash "$layouts_dir/$session.sh" ||
      tmux new-session -d -s "$session" -c "$cwd"
  elif [[ -n $layouts_dir && -f "$layouts_dir/default.sh" ]]; then
    bash "$layouts_dir/default.sh" "$session" "$cwd" ||
      tmux new-session -d -s "$session" -c "$cwd"
  else
    tmux new-session -d -s "$session" -c "$cwd"
  fi

  run_hook post-create "$session" "$cwd" "$source"

  to_session "$session"
}

# -- try to change to an existing session; otherwise, create a new one
function try_session() {
  local session cwd source line fresh=0
  # fzf output: query line first; alt-enter's accept appends the FTM_FRESH
  # marker after it (print() mimics --expect: query, marker, selection) —
  # scan every line, honor the marker anywhere, keep the first session line
  session="" cwd="" source="default"
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    if [[ $line == "$FTM_FRESH" ]]; then fresh=1; continue; fi
    [[ -n $session ]] && continue
    if [[ $line == *$TAB* ]]; then
      # zoxide entry: "name<TAB>path" (~ shortened for display)
      session="${line%%"$TAB"*}"
      cwd="${line#*"$TAB"}"
      cwd="${cwd#\\}" # heal rows rendered by bash 3.2's \~ replacement
      cwd="${cwd/#\~/$HOME}"
      source="zoxide"
    else
      session="$(strip_markers "$line")"
    fi
  done <<<"$1"
  [[ -n $session ]] || exit 0
  # divider row (all dashes): backstop — the enter bind already ignores it
  [[ $session =~ ^-+$ ]] && exit 0

  if [[ -z $cwd ]]; then
    cwd=$(zoxide query "$session" 2>/dev/null || true)
    [[ -n $cwd ]] && source="zoxide"
  fi

  # backup plan: use code dir if zoxide finds nothing
  if [[ -z "$cwd" ]]; then
    cwd="$HOME/code"
    source="default"
  fi

  to_session "$session" 2>/dev/null || {
    if [[ $fresh == 1 ]]; then new_session "$session" "$cwd" fresh
    else new_session "$session" "$cwd" "$source"
    fi
  }
}

function fuzzy_find() {
  local current_session sessions_count fzf_list
  local fzf_prompt_text fzf_header_text selected_session
  declare -a fzf_extra_args=()

  current_session="$(tmux display-message -p '#S')"
  fzf_list="$(print_list "$current_session")"

  sessions_count=0
  while IFS= read -r _; do sessions_count=$((sessions_count + 1)); done \
    < <(tmux list-sessions -F '#S' 2>/dev/null || true)

  if [[ $sessions_count -le 1 ]]; then
    fzf_prompt_text=" create new session  "
    fzf_header_text="󰢩 recent dirs & layouts [alt-enter: fresh]"
  else
    fzf_prompt_text=" new or existing session  "
    fzf_header_text="󰢩 ${C_ITALIC}${C_MAGENTA}${current_session}${C_RESET} [${C_WHITE}ctrl-k${C_RESET}: ${C_GRAY}kill / ${C_WHITE}ctrl-r${C_RESET}: ${C_GRAY}rename / ${C_WHITE}alt-enter${C_RESET}: ${C_GRAY}fresh${C_RESET}]"
  fi

  # -- picker actions; reload regenerates the annotated list so markers stay correct
  # Enter/Alt-Enter nest their divider check: fzf skips any action whose
  # template contains a bare {} when nothing matches, which made Enter a no-op
  # on typed queries with no matching row. The outer transform is
  # placeholder-free ($FZF_MATCH_COUNT env, \{} escaped), so it always runs;
  # the {} dash-check only runs when a current item exists. Alt-Enter uses
  # accept, not print-query: print() mimics --expect (query, marker, selection
  # output order) and print-query drops queued print() lines entirely.
  # shellcheck disable=SC2016 # fzf action templates: {} and $() expand in fzf's shell, not here
  # "=" prefix forces exact session-name match (names like .dotfiles-... otherwise
  # trip tmux's target parser, which treats a leading dot as a window separator)
  local kill_action='execute-silent(tmux-kill-session "$(printf %s {} | sed -E "s/\t.*$//; s/ [●○]$//")")+reload(ftm --list)' \
    rename_action='execute(session=$(printf %s {} | sed -E "s/\t.*$//; s/ [●○]$//"); printf >&2 "New session name: "; read -r name; tmux rename-session -t "$(ftm --id="$session")" "${name}")+reload(ftm --list)'

  # native fzf tmux popup unless we're already inside one (-p)
  [[ $POPUP == "true" ]] || fzf_extra_args+=(--tmux "center,70%,75%")

  # shellcheck disable=SC2016 # fzf transform templates: $FZF_MATCH_COUNT and {} expand in fzf's shell
  selected_session="$(
    fzf \
      ${fzf_extra_args[@]+"${fzf_extra_args[@]}"} \
      --height=100% \
      --ansi \
      --reverse \
      --border=none \
      --scrollbar="▌▐" \
      --padding="1" \
      --prompt="${fzf_prompt_text}" \
      --header="${fzf_header_text}" \
      --color="bg:#3c474d,bg+:#323d43,preview-bg:#262b31" \
      --preview="ftm --preview={}" \
      --preview-window="down,65%,nowrap" \
      --with-shell="bash -c" \
      --bind="change:first" \
      --bind="?:toggle-preview" \
      --bind="ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down" \
      --bind="ctrl-k:${kill_action}" \
      --bind="ctrl-x:${kill_action}" \
      --bind="ctrl-r:${rename_action}" \
      --bind='enter:transform:if [[ $FZF_MATCH_COUNT -eq 0 ]]; then echo print-query; else echo "transform:[[ \{} =~ ^-+$ ]] && echo ignore || echo replace-query+print-query"; fi' \
      --bind="alt-enter:transform:if [[ \$FZF_MATCH_COUNT -eq 0 ]]; then echo 'print(${FTM_FRESH})+accept'; else echo \"transform:[[ \{} =~ ^-+\$ ]] && echo ignore || echo 'print(${FTM_FRESH})+replace-query+accept'\"; fi" \
      --pointer='▌' \
      --marker='󰛄' \
      --print-query <<<"$fzf_list"
  )" || true

  try_session "$selected_session"
}

# ---------------------------------------------------------------------------
# Deterministic ensure / repair / remove (worktree-retaining design §5).
#
# Non-interactive lifecycle operations for wt and direct callers. They never
# open the picker, never restore snapshots or named layouts, and repair is
# additive-only (extra windows and panes are preserved; nothing is killed,
# merged, or renamed except adopting one legacy services-NNNN window).
# Worktree mode serializes through the shared mkdir lock primitive
# (bin/wt-lock-lib) and accepts an inherited lease token from wt; generic
# mode uses the same lifecycle without Git locks or worktree tags.

DET_CMD="" DET_KIND="" DET_CWD="" DET_SESSION="" DET_WID=""
DET_LEASE="" DET_ATTACH=auto DET_FORMAT=text DET_PI_SESSION=""
DET_PRESENTATION=session DET_PRIMARY=0
DET_RESTART_SERVICES=0 DET_DISCARD_SNAPSHOT=0
DET_GCD="" DET_OWNED_LEASE="" DET_SETUP_STATE=skipped
DET_TMUX_ACTION="" DET_W_CODE="" DET_W_AGENT="" DET_W_SERVICES="" DET_WINDOW_ID=""

function det_json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

function det_release_locks() {
  [[ -n $DET_OWNED_LEASE && -n $DET_GCD ]] || return 0
  wtlock_release "$DET_GCD" "$DET_WID" "$DET_OWNED_LEASE" || true
  DET_OWNED_LEASE=""
}

# det_error EXIT CODE PHASE MESSAGE — emit one JSON error document (or a
# stderr line in text mode), release owned locks, and exit.
function det_error() {
  local exit_code="$1" code="$2" phase="$3" message="$4"
  det_release_locks
  if [[ $DET_FORMAT == json ]]; then
    printf '{"schema_version":1,"command":"%s","status":"error","phase":"%s","error":{"code":"%s","message":"%s"},"attached":false,"warnings":[]}\n' \
      "$(det_json_escape "$DET_CMD")" "$(det_json_escape "$phase")" \
      "$(det_json_escape "$code")" "$(det_json_escape "$message")"
  else
    printf 'ftm %s: %s: %s\n' "$DET_CMD" "$code" "$message" >&2
  fi
  exit "$exit_code"
}

function det_wait_ms() {
  # JSON/noninteractive callers never wait; interactive callers wait bounded.
  if [[ $DET_FORMAT == json ]]; then printf 0; else printf '%s' "${FTM_LOCK_WAIT_MS:-5000}"; fi
}

function det_parse() {
  DET_CMD="$1"
  shift
  local a
  # Pre-scan for --format so even usage errors honor JSON mode.
  local -a argv=("$@")
  local i=0
  while [[ $i -lt $# ]]; do
    if [[ ${argv[$i]} == --format && $((i + 1)) -lt $# && ${argv[$((i + 1))]} == json ]]; then
      DET_FORMAT=json
    fi
    i=$((i + 1))
  done
  while [[ $# -gt 0 ]]; do
    a="$1"
    case "$a" in
      --kind | --cwd | --session | --worktree-id | --lease | --attach | --format | --pi-session)
        [[ $# -ge 2 ]] || det_error 2 usage args "missing value for $a"
        case "$a" in
          --kind) DET_KIND="$2" ;;
          --cwd) DET_CWD="$2" ;;
          --session) DET_SESSION="$2" ;;
          --worktree-id) DET_WID="$2" ;;
          --lease) DET_LEASE="$2" ;;
          --attach) DET_ATTACH="$2" ;;
          --format) DET_FORMAT="$2" ;;
          --pi-session) DET_PI_SESSION="$2" ;;
        esac
        shift 2
        ;;
      --presentation)
        [[ $# -ge 2 ]] || det_error 2 usage args 'missing value for --presentation'
        DET_PRESENTATION="$2"; shift 2
        [[ $DET_PRESENTATION == cd || $DET_PRESENTATION == window || $DET_PRESENTATION == session ]] || det_error 2 usage args '--presentation must be cd|window|session'
        ;;
      --primary)
        [[ $DET_CMD == ensure || $DET_CMD == repair ]] || det_error 2 usage args '--primary is valid only for ensure/repair'
        DET_PRIMARY=1; shift ;;
      --restart-services)
        DET_RESTART_SERVICES=1
        shift
        ;;
      --discard-snapshot)
        DET_DISCARD_SNAPSHOT=1
        shift
        ;;
      *) det_error 2 usage args "unknown argument: $a" ;;
    esac
  done
  [[ $DET_FORMAT == json || $DET_FORMAT == text ]] || det_error 2 usage args "--format must be json|text"
  [[ $DET_ATTACH == auto || $DET_ATTACH == never ]] || det_error 2 usage args "--attach must be auto|never"
  [[ -n $DET_SESSION ]] || det_error 2 usage args '--session is required'
  valid_snapshot_name "$DET_SESSION" || det_error 2 usage args 'invalid session name'
  if [[ -n $DET_PI_SESSION && ! $DET_PI_SESSION =~ ^[0-9a-fA-F][0-9a-fA-F-]*$ ]]; then
    det_error 2 usage args 'invalid --pi-session UUID'
  fi
  if [[ $DET_CMD == ensure || $DET_CMD == repair ]]; then
    [[ -n $DET_KIND ]] || det_error 2 usage args '--kind is required'
    [[ $DET_KIND == worktree || $DET_KIND == generic ]] || det_error 2 usage args "--kind must be worktree|generic"
    [[ $DET_PRIMARY == 0 || $DET_KIND == worktree ]] || det_error 2 usage args '--primary requires --kind worktree'
    [[ -n $DET_CWD ]] || det_error 2 usage args '--cwd is required'
    if [[ $DET_KIND == worktree ]]; then
      [[ -n $DET_WID ]] || det_error 2 usage args '--worktree-id is required for --kind worktree'
    fi
  fi
}

function det_tag() { # $1 = session id, $2 = option name
  tmux show-options -t "$1" -qv "$2" 2>/dev/null || true
}

# Sessions other than the target that are tagged for the same worktree
# path/id. Any hit is an ambiguity: never choose between duplicates.
function det_find_tagged_conflicts() {
  local line sid name k p i
  while IFS= read -r line; do
    sid="${line%% *}"
    name="${line#* }"
    [[ $name == "$DET_SESSION" ]] && continue
    k="$(det_tag "$sid" @ftm_kind)"
    [[ $k == worktree ]] || continue
    p="$(det_tag "$sid" @ftm_worktree)"
    i="$(det_tag "$sid" @ftm_worktree_id)"
    if [[ $p == "$DET_CWD" || (-n $DET_WID && $i == "$DET_WID") ]]; then
      printf '%s\n' "$name"
    fi
  done < <(tmux list-sessions -F '#{session_id} #{session_name}' 2>/dev/null || true)
  return 0
}

# Read-only identity validation of the requested session before setup or any
# mutation. Tagged sessions must match exactly; untagged sessions are adopted
# only when the session cwd and every standard-window pane cwd equal the
# requested canonical path. Everything else is a conflict — never mutate.
function det_validate_existing() { # $1 = session id
  local k p i spath wname pcwd
  k="$(det_tag "$1" @ftm_kind)"
  if [[ -n $k ]]; then
    [[ $k == "$DET_KIND" ]] ||
      det_error 5 session_conflict identity "session '$DET_SESSION' is tagged kind '$k', expected '$DET_KIND'"
    if [[ $DET_KIND == worktree ]]; then
      p="$(det_tag "$1" @ftm_worktree)"
      i="$(det_tag "$1" @ftm_worktree_id)"
      [[ $p == "$DET_CWD" && $i == "$DET_WID" ]] ||
        det_error 5 session_conflict identity "session '$DET_SESSION' is tagged for a different worktree"
    fi
    return 0
  fi
  spath="$(tmux display-message -p -t "$1" '#{session_path}' 2>/dev/null || true)"
  [[ $spath == "$DET_CWD" ]] ||
    det_error 5 session_conflict identity "session '$DET_SESSION' path '$spath' does not match '$DET_CWD'"
  while IFS=$TAB read -r wname pcwd; do
    case "$wname" in
      code | agent | services | services-[0-9]*)
        [[ $pcwd == "$DET_CWD" ]] ||
          det_error 5 session_conflict identity "window '$wname' pane cwd '$pcwd' does not match '$DET_CWD'"
        ;;
    esac
  done < <(tmux list-panes -s -t "$1" -F '#{window_name}'"$TAB"'#{pane_current_path}' 2>/dev/null || true)
  return 0
}

function det_task_exists() { # $1 = mise task name, probed in the target cwd
  command -v mise >/dev/null 2>&1 || return 1
  (cd "$DET_CWD" && mise tasks info --json "$1" </dev/null >/dev/null 2>&1)
}

# Blocking dev:setup gate: runs after identity validation and before any tmux
# mutation. A missing task is reported as missing, not failed.
function det_run_setup() {
  if det_task_exists dev:setup; then
    # Worktree mode supplies the canonical GIT_WORKTREE so project env
    # derivation (ports, db names) consumes the exact id instead of
    # re-deriving it (setup runs in ftm's process, not a tmux pane, so the
    # session environment does not apply here).
    local -a setup_env=()
    [[ $DET_KIND == worktree && -n $DET_WID && $DET_PRIMARY == 0 ]] && setup_env=("GIT_WORKTREE=$DET_WID")
    if (cd "$DET_CWD" && env ${setup_env[@]+"${setup_env[@]}"} mise run dev:setup </dev/null >&2); then
      DET_SETUP_STATE=completed
    else
      det_error 4 setup_failed setup 'dev:setup exited nonzero'
    fi
  else
    DET_SETUP_STATE=missing
  fi
}

function det_window_id() { # $1 = session id, $2 = exact window name
  tmux list-windows -t "$1" -F '#{window_id} #{window_name}' 2>/dev/null |
    awk -v n="$2" '$2 == n { print $1; exit }' || true
}

function det_services_window_id() { # $1 = session id; recognizes legacy services-NNNN
  tmux list-windows -t "$1" -F '#{window_id} #{window_name}' 2>/dev/null |
    awk '$2 ~ /^services(-[0-9]+)?$/ { print $1; exit }' || true
}

# Additive canonical layout: create only missing code/agent/services windows,
# tag the session, and never touch unrelated windows or panes.
function det_build() {
  local sid q agent_cmd wid wname pcwd created_any=0
  q="$(printf %q "$DET_CWD")"
  if sid="$(session_id_for "$DET_SESSION")"; then
    DET_TMUX_ACTION=reused
  else
    tmux new-session -d -s "$DET_SESSION" -n code -c "$DET_CWD" ||
      det_error 7 tmux_failed tmux 'could not create session'
    sid="$(session_id_for "$DET_SESSION")" ||
      det_error 7 tmux_failed tmux 'created session not found'
    DET_TMUX_ACTION=created
  fi
  tmux set-option -t "$sid" @ftm_kind "$DET_KIND"
  tmux set-option -t "$sid" @ftm_schema 1
  if [[ $DET_KIND == worktree ]]; then
    tmux set-option -t "$sid" @ftm_worktree "$DET_CWD"
    tmux set-option -t "$sid" @ftm_worktree_id "$DET_WID"
    if [[ $DET_PRIMARY == 1 ]]; then
      tmux setenv -u -t "$sid" GIT_WORKTREE 2>/dev/null || true
    else
      tmux setenv -t "$sid" GIT_WORKTREE "$DET_WID"
    fi
  fi

  if [[ -n "$(det_window_id "$sid" code)" ]]; then
    DET_W_CODE=present
  else
    tmux new-window -d -t "$sid" -n code -c "$DET_CWD"
    DET_W_CODE=created
    created_any=1
  fi

  if [[ -n "$(det_window_id "$sid" agent)" ]]; then
    DET_W_AGENT=present
  else
    # Exact-cwd Pi: tmux cwd AND process cwd both set to the canonical path;
    # pi -c continues the latest session stored for exactly that directory.
    # An explicit Pi session UUID targets a known session instead. Launch
    # through `mise exec` when available so pi's process env carries the
    # project's [env] (PHX_PORT etc.) — required for env-interpolated MCP
    # URLs like ${PHX_PORT} — falling back to a direct exec without mise.
    local pi_args
    if [[ -n $DET_PI_SESSION ]]; then
      pi_args="--session $DET_PI_SESSION"
    else
      pi_args="-c"
    fi
    # The command string runs via tmux's default shell (possibly fish), so it
    # must stay POSIX-and-fish portable: no if/then, just cd && exec. Mise
    # availability is decided here in ftm, like det_task_exists.
    if command -v mise >/dev/null 2>&1; then
      agent_cmd="cd -- $q && exec mise exec -- pi $pi_args"
    else
      agent_cmd="cd -- $q && exec pi $pi_args"
    fi
    tmux new-window -d -t "$sid" -n agent -c "$DET_CWD" "$agent_cmd"
    DET_W_AGENT=created
    created_any=1
  fi

  wid="$(det_services_window_id "$sid")"
  if [[ -n $wid ]]; then
    tmux set-option -w -t "$wid" remain-on-exit on 2>/dev/null || true
    # Adopt one legacy services-NNNN window: rename only when no exact
    # `services` window exists and the pane cwd matches.
    wname="$(tmux display-message -p -t "$wid" '#{window_name}' 2>/dev/null || true)"
    if [[ $wname != services && -z "$(det_window_id "$sid" services)" ]]; then
      pcwd="$(tmux display-message -p -t "$wid" '#{pane_current_path}' 2>/dev/null || true)"
      [[ $pcwd == "$DET_CWD" ]] && tmux rename-window -t "$wid" services 2>/dev/null || true
    fi
    if [[ "$(tmux display-message -p -t "$wid" '#{pane_dead}' 2>/dev/null || true)" == 1 ]]; then
      if [[ $DET_CMD == repair && $DET_RESTART_SERVICES == 1 ]] && det_task_exists dev:services; then
        tmux respawn-pane -k -t "$wid" "cd -- $q && exec mise run dev:services"
        DET_W_SERVICES=started
        created_any=1
      else
        DET_W_SERVICES=dead
      fi
    else
      DET_W_SERVICES=present
    fi
  else
    # Create the window with a shell first so remain-on-exit is set before the
    # service command can exit (startup failures stay visible).
    wid="$(tmux new-window -d -P -F '#{window_id}' -t "$sid" -n services -c "$DET_CWD")" ||
      det_error 7 tmux_failed tmux 'could not create services window'
    tmux set-option -w -t "$wid" remain-on-exit on
    if det_task_exists dev:services; then
      tmux respawn-pane -k -t "$wid" "cd -- $q && exec mise run dev:services"
      DET_W_SERVICES=started
    else
      DET_W_SERVICES=shell
    fi
    created_any=1
  fi

  if [[ $DET_TMUX_ACTION == reused && $created_any == 1 ]]; then
    DET_TMUX_ACTION=repaired
  fi
}

function det_window_build() {
  local sid wid left right q candidate count=0 name path id roles cpath cid role
  if [[ -z ${TMUX:-} || -z ${TMUX_PANE:-} ]]; then DET_PRESENTATION="cd"; return 0; fi
  sid="$(tmux display-message -p -t "$TMUX_PANE" '#{session_id}' 2>/dev/null || true)"
  if [[ -z $sid ]]; then DET_PRESENTATION="cd"; return 0; fi
  q="$(printf %q "$DET_CWD")"
  while IFS=$TAB read -r candidate name; do
    path="$(tmux show-options -w -t "$candidate" -qv @ftm_worktree 2>/dev/null || true)"
    id="$(tmux show-options -w -t "$candidate" -qv @ftm_worktree_id 2>/dev/null || true)"
    if [[ $name == "wt:$DET_WID" && ($path != "$DET_CWD" || $id != "$DET_WID") ]]; then
      det_error 5 window_conflict identity "window name '$name' is already used"
    fi
    if [[ $path == "$DET_CWD" || $id == "$DET_WID" ]]; then
      [[ $path == "$DET_CWD" && $id == "$DET_WID" ]] || det_error 5 window_conflict identity 'window tags match only part of the worktree identity'
      count=$((count + 1)); wid="$candidate"
    fi
  done < <(tmux list-windows -t "$sid" -F '#{window_id}'"$TAB"'#{window_name}' 2>/dev/null || true)
  [[ $count -le 1 ]] || det_error 5 ambiguous_window identity 'multiple windows match the worktree'
  if [[ $count == 1 ]]; then
    roles="$(tmux list-panes -t "$wid" -F '#{pane_id}'"$TAB"'#{@ftm_role}'"$TAB"'#{@ftm_worktree}'"$TAB"'#{@ftm_worktree_id}' 2>/dev/null || true)"
    left=; right=; cpath=; cid=; role=
    while IFS=$TAB read -r candidate role cpath cid; do
      [[ $cpath == "$DET_CWD" && $cid == "$DET_WID" ]] || det_error 5 window_conflict identity 'tagged pane identity does not match worktree'
      case "$role" in code) left="$candidate" ;; services) right="$candidate" ;; *) det_error 5 window_conflict identity 'window has an unknown tagged pane role' ;; esac
    done <<<"$roles"
    [[ -n $left && -n $right ]] || det_error 5 window_conflict identity 'reused window lacks exact code/services panes'
    [[ $(printf '%s\n' "$roles" | wc -l | tr -d ' ') == 2 ]] || det_error 5 window_conflict identity 'reused window must contain exactly two tagged panes'
    DET_W_CODE="$left"; DET_W_SERVICES="$right"; DET_WINDOW_ID="$wid"; DET_TMUX_ACTION=reused
    return 0
  fi
  wid="$(tmux new-window -d -P -F '#{window_id}' -t "$sid" -n "wt:$DET_WID" -c "$DET_CWD")" || det_error 7 tmux_failed tmux 'could not create worktree window'
  tmux set-option -w -t "$wid" @ftm_kind worktree
  tmux set-option -w -t "$wid" @ftm_worktree "$DET_CWD"
  tmux set-option -w -t "$wid" @ftm_worktree_id "$DET_WID"
  tmux set-option -w -t "$wid" @ftm_role worktree
  left="$(tmux display-message -p -t "$wid" '#{pane_id}')"
  right="$(tmux split-window -h -p 40 -d -P -F '#{pane_id}' -t "$left" -c "$DET_CWD")" || det_error 7 tmux_failed tmux 'could not split worktree window'
  tmux set-option -p -t "$left" @ftm_worktree "$DET_CWD"; tmux set-option -p -t "$left" @ftm_worktree_id "$DET_WID"; tmux set-option -p -t "$left" @ftm_role code
  tmux set-option -p -t "$right" @ftm_worktree "$DET_CWD"; tmux set-option -p -t "$right" @ftm_worktree_id "$DET_WID"; tmux set-option -p -t "$right" @ftm_role services
  if [[ $DET_PRIMARY == 1 ]]; then
    tmux send-keys -t "$left" 'unset GIT_WORKTREE' Enter
  else
    tmux send-keys -t "$left" "export GIT_WORKTREE=$(printf %q "$DET_WID")" Enter
  fi
  tmux set-option -w -t "$wid" remain-on-exit on
  if det_task_exists dev:services; then
    if [[ $DET_PRIMARY == 1 ]]; then tmux respawn-pane -k -t "$right" "unset GIT_WORKTREE; cd -- $q && exec mise run dev:services"; else tmux respawn-pane -k -t "$right" "export GIT_WORKTREE=$(printf %q "$DET_WID"); cd -- $q && exec mise run dev:services"; fi
  else
    if [[ $DET_PRIMARY == 1 ]]; then tmux send-keys -t "$right" 'unset GIT_WORKTREE' Enter; else tmux send-keys -t "$right" "export GIT_WORKTREE=$(printf %q "$DET_WID")" Enter; fi
  fi
  DET_W_CODE="$left"; DET_W_SERVICES="$right"; DET_TMUX_ACTION=created; DET_WINDOW_ID="$wid"
}

function det_emit_ok() {
  det_release_locks
  if [[ $DET_FORMAT == json ]]; then
    printf '{"schema_version":1,"command":"%s","status":"ok","kind":"%s","session":"%s","cwd":"%s","setup":{"state":"%s"},"presentation":"%s","tmux":{"session":"%s","window_id":"%s","left_pane":"%s","action":"%s","windows":{"code":"%s","agent":"%s","services":"%s"}},"attached":false,"warnings":[]}\n' \
      "$(det_json_escape "$DET_CMD")" "$(det_json_escape "$DET_KIND")" \
      "$(det_json_escape "$DET_SESSION")" "$(det_json_escape "$DET_CWD")" \
      "$DET_SETUP_STATE" "$DET_PRESENTATION" "$(det_json_escape "$DET_SESSION")" "$DET_WINDOW_ID" "$DET_W_CODE" "$DET_TMUX_ACTION" \
      "$DET_W_CODE" "$DET_W_AGENT" "$DET_W_SERVICES"
  else
    printf 'ftm %s: session %s %s (code=%s agent=%s services=%s setup=%s)\n' \
      "$DET_CMD" "$DET_SESSION" "$DET_TMUX_ACTION" \
      "$DET_W_CODE" "$DET_W_AGENT" "$DET_W_SERVICES" "$DET_SETUP_STATE" >&2
  fi
}

function det_attach() {
  [[ $DET_ATTACH == auto ]] || return 0
  [[ $DET_FORMAT != json ]] || return 0
  [[ -z ${FTM_NO_ATTACH:-} ]] || return 0
  local sid
  sid="$(session_id_for "$DET_SESSION")" || return 0
  bump_recent "$DET_SESSION" "$DET_CWD"
  if [[ -n $TMUX ]]; then
    tmux switch-client -t "$sid"
  else
    tmux attach-session -t "$sid"
  fi
}

function det_ensure() {
  # Absolutize only; do not resolve symlinks. Callers (wt) supply the exact
  # canonical worktree path, and tags/adoption checks must use it verbatim.
  DET_CWD="$(cd -- "$DET_CWD" 2>/dev/null && pwd)" ||
    det_error 2 usage args "cwd is not a directory: $DET_CWD"
  if [[ $DET_KIND == worktree ]]; then
    DET_GCD="$(git -C "$DET_CWD" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ||
      det_error 7 git_context_failed resolve "not a Git worktree: $DET_CWD"
    if [[ -n $DET_LEASE ]]; then
      wtlock_validate_lease "$DET_GCD" "$DET_WID" "$DET_LEASE" ||
        det_error 7 invalid_lease lock 'lease token does not match held locks'
    else
      DET_OWNED_LEASE="$(wtlock_acquire "$DET_GCD" "$DET_WID" "$(det_wait_ms)")" ||
        det_error 7 busy lock 'repository or worktree lock is held by another operation'
    fi
  fi
  local sid conflicts
  if [[ $DET_PRESENTATION == session && $DET_KIND == worktree ]]; then
    conflicts="$(det_find_tagged_conflicts)"
    [[ -z $conflicts ]] ||
      det_error 5 ambiguous_session identity "other sessions tagged for this worktree: ${conflicts//$'\n'/, }"
  fi
  if sid="$(session_id_for "$DET_SESSION")" && [[ $DET_PRESENTATION == session ]]; then
    det_validate_existing "$sid"
  fi
  det_run_setup
  if [[ $DET_PRESENTATION == cd ]]; then
    DET_TMUX_ACTION=skipped
  elif [[ $DET_PRESENTATION == window ]]; then
    det_window_build
  else
    det_build
  fi
  det_emit_ok
  [[ $DET_PRESENTATION == session ]] && det_attach
  exit 0
}

function det_remove() {
  local sid k p wid_tag base f
  if [[ -n $DET_CWD ]]; then
    DET_CWD="$(cd -- "$DET_CWD" 2>/dev/null && pwd)" ||
      det_error 2 usage args "cwd is not a directory: $DET_CWD"
  fi
  if ! sid="$(session_id_for "$DET_SESSION")"; then
    det_release_locks
    if [[ $DET_FORMAT == json ]]; then
      printf '{"schema_version":1,"command":"remove","status":"ok","session":"%s","tmux":{"action":"absent"},"attached":false,"warnings":[]}\n' \
        "$(det_json_escape "$DET_SESSION")"
    else
      printf 'ftm remove: session %s already absent\n' "$DET_SESSION" >&2
    fi
    exit 0
  fi
  k="$(det_tag "$sid" @ftm_kind)"
  p="$(det_tag "$sid" @ftm_worktree)"
  if [[ -n $DET_CWD && -n $p && $p != "$DET_CWD" ]]; then
    det_error 5 session_conflict identity "session '$DET_SESSION' is tagged for '$p', not '$DET_CWD'"
  fi
  if [[ $k == worktree ]]; then
    wid_tag="$(det_tag "$sid" @ftm_worktree_id)"
    [[ -n $DET_WID ]] || DET_WID="$wid_tag"
    base="${p:-$DET_CWD}"
    if [[ -n $base ]] && DET_GCD="$(git -C "$base" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
      if [[ -n $DET_LEASE ]]; then
        wtlock_validate_lease "$DET_GCD" "$DET_WID" "$DET_LEASE" ||
          det_error 7 invalid_lease lock 'lease token does not match held locks'
      else
        DET_OWNED_LEASE="$(wtlock_acquire "$DET_GCD" "$DET_WID" "$(det_wait_ms)")" ||
          det_error 7 busy lock 'repository or worktree lock is held by another operation'
      fi
    fi
  fi
  tmux kill-session -t "$sid" || det_error 7 tmux_failed tmux 'kill-session failed'
  if [[ $DET_DISCARD_SNAPSHOT == 1 ]] && valid_snapshot_name "$DET_SESSION"; then
    f="$(snapshot_file "$DET_SESSION")"
    if [[ -e $f ]]; then
      trash "$f" 2>/dev/null || rm -f -- "$f"
    fi
  fi
  det_release_locks
  if [[ $DET_FORMAT == json ]]; then
    printf '{"schema_version":1,"command":"remove","status":"ok","session":"%s","tmux":{"action":"removed"},"attached":false,"warnings":[]}\n' \
      "$(det_json_escape "$DET_SESSION")"
  else
    printf 'ftm remove: session %s removed\n' "$DET_SESSION" >&2
  fi
  exit 0
}

case "${1:-}" in
  ensure | repair | remove)
    # shellcheck source=bin/wt-lock-lib
    source "$script_dir/wt-lock-lib"
    det_parse "$@"
    if [[ $DET_CMD == remove ]]; then
      det_remove
    else
      det_ensure
    fi
    # Defensive stop: deterministic calls must never fall through to the picker.
    # shellcheck disable=SC2317
    exit 0
    ;;
esac

while getopts "phs:-:" OPTION; do
  case $OPTION in
  p)
    export TMUX_POPUP=1
    POPUP="true"
    ;;
  h)
    __help
    ;;
  s)
    snapshot_session "$OPTARG"
    exit 0
    ;;
  -)
    case "$OPTARG" in
    snapshot=*)
      snapshot_session "${OPTARG#snapshot=}"
      exit 0
      ;;
    snapshot-all)
      snapshot_all
      exit 0
      ;;
    list)
      # internal: annotated list for fzf reload binds
      print_list "$(tmux display-message -p '#S' 2>/dev/null || true)"
      exit 0
      ;;
    id=*)
      # internal: session name -> id for picker actions
      session_id_for "${OPTARG#id=}"
      exit $?
      ;;
    preview=*)
      # internal: fzf preview for a picker entry
      preview_entry "${OPTARG#preview=}"
      exit 0
      ;;
    help) __help ;;
    *)
      echo "Invalid Option: --$OPTARG" 1>&2
      exit 1
      ;;
    esac
    ;;
  \?)
    # bash leaves OPTARG unset for invalid options; guard for set -u
    echo "Invalid Option: -${OPTARG:-}" 1>&2
    exit 1
    ;;
  :)
    echo "Invalid Option: -${OPTARG:-} requires an argument" 1>&2
    exit 1
    ;;
  esac
done
shift "$((OPTIND - 1))"

# -- this is our given session_name param, sans options
session_name="${1:-}"

[[ -n $TMUX ]] && change="switch-client" || change="attach-session"

# -- if we pass in a session_name: attach/switch to it or, create new session
if [[ $session_name ]]; then
  try_session "$session_name"
  exit 0
elif [[ -z $TMUX ]]; then
  __help
fi

fuzzy_find
