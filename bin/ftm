#!/usr/bin/env bash

#
# ftm — fuzzy tmux session/layout switcher
#
# ftm [options] [SESSION_NAME | FUZZY_PATTERN]
#
# Running `ftm` with no argument opens a fuzzy-finder over recent sessions,
# pre-defined layouts, running sessions, and the top zoxide directories.
# Passing an argument switches to that session if it exists or creates it
# (layout script of the same name wins).
#
# Picker ordering (top → bottom):
#   1. ftm's own MRU list (state file; every switch/create bumps an entry
#      as "name<TAB>cwd", so entries whose session died but whose dir still
#      exists — e.g. killed worktree sessions — keep rendering and recreate
#      in the right directory)
#   2. running sessions not in MRU, by tmux last-attached (desc)
#   3. top zoxide dirs (frecency order) not already listed, shown as
#      "name<TAB>dimmed-path"; names colliding with a layout script defer to
#      the layout entry (layout wins on select)
#   4. remaining layouts, alphabetical
#
# Hooks (similar to wt/mise hooks): executable scripts in
# $TMUX_HOOKS (default ~/.config/tmux/hooks), one per event:
#   pre-create.sh   before a new session is built
#   post-create.sh  after a new session is built, before switching
#   post-switch.sh  after any switch/attach (including brand-new sessions)
# Each receives: $1 session name, $2 cwd (session path), $3 source
# (layout|zoxide|default), plus FTM_EVENT/FTM_SESSION/FTM_CWD/FTM_SOURCE env.
#
# Keybinds in the picker:
#   enter   switch/create session from selection or typed query
#   ctrl-k  kill selected session (ctrl-x also works)
#   ctrl-r  rename selected session
#
# Dependencies: tmux, fzf (>= 0.53 for native --tmux popups); zoxide optional
#

set -euo pipefail

__base="${0##*/}"

TMUX="${TMUX:-}"
TMUX_LAYOUTS="${TMUX_LAYOUTS:-$HOME/.config/tmux/layouts}"
TMUX_HOOKS="${TMUX_HOOKS:-$HOME/.config/tmux/hooks}"
POPUP="false"
PI_STATE_DIR="${PI_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/pi}"
FTM_STATE_DIR="${FTM_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ftm}"
FTM_ZOXIDE_LIMIT="${FTM_ZOXIDE_LIMIT:-10}"
recent_file="$FTM_STATE_DIR/recent"

[[ -d $TMUX_LAYOUTS ]] && layouts_dir="$TMUX_LAYOUTS" || layouts_dir=""

# -- ANSI colors as literals (tput spawns a process per call)
C_RESET=$'\e[0m'
C_ITALIC=$'\e[3m'
C_MAGENTA=$'\e[35m'
C_WHITE=$'\e[38;5;255m'
C_GRAY=$'\e[38;5;245m'
C_RED=$'\e[31m'
C_GREEN=$'\e[32m'
C_BOLD=$'\e[1m'
C_DIM=$'\e[2m'

TAB=$'\t'

function __help() {
  local tmux_running fzf_found
  [[ -n $TMUX ]] && tmux_running="running" || tmux_running="not running"
  command -v fzf &>/dev/null && fzf_found="installed" || fzf_found="not installed"

  printf -- "Usage: %s [options] [SESSION_NAME | FUZZY_PATTERN]\n" "$__base"
  printf -- "\n"
  printf -- "   Options:\n"
  printf -- "     -p              Run fzf directly (already inside a tmux popup); default uses fzf --tmux\n"
  printf -- "     -h              This help text you're presently reading. 😄\n"
  printf -- "\n"
  printf -- "   Hooks (executable scripts in \$TMUX_HOOKS, default ~/.config/tmux/hooks):\n"
  printf -- "     pre-create.sh / post-create.sh / post-switch.sh\n"
  printf -- "     args: SESSION CWD SOURCE (layout|zoxide|default)\n"
  printf -- "\n"
  printf -- "   Dependencies:\n"
  printf -- "     tmux            (%s)\n" "$tmux_running"
  printf -- "     fzf             (%s)\n" "$fzf_found"
  printf -- "\n"

  exit 0
}

if ! command -v fzf &>/dev/null; then
  printf -- "ERROR: %s requires fzf to be installed\n" "$__base"
  __help
  # shellcheck disable=SC2317 # defensive; __help exits
  exit 1
fi

# -- strip the pi status dot and any zoxide path column (running sessions
#    render bold instead of carrying a text marker; fzf's --ansi strips the
#    styling before selections reach us)
function strip_markers() {
  local s="$1"
  s="${s%%"$TAB"*}"
  s="${s% ●}"
  printf '%s' "$s"
}

# -- resolve a session name to its id ($N). tmux target parsing mangles names
#    with a leading dot (reads it as a window separator; "=" doesn't help), so
#    every tmux command targeting an existing session goes through ids.
function session_id_for() {
  local name="$1" line
  while IFS= read -r line; do
    if [[ ${line#* } == "$name" ]]; then
      printf '%s' "${line%% *}"
      return 0
    fi
  done < <(tmux list-sessions -F '#{session_id} #{session_name}' 2>/dev/null)
  return 1
}

# -- run an event hook if present+executable. Never fails the caller.
function run_hook() {
  local event="$1" session="$2" cwd="$3" source="$4"
  local hook="$TMUX_HOOKS/$event.sh"
  [[ -x $hook ]] || return 0
  FTM_EVENT="$event" FTM_SESSION="$session" FTM_CWD="$cwd" FTM_SOURCE="$source" \
    bash "$hook" "$session" "$cwd" "$source" || true
}

# -- like run_hook but detached (nohup + backgrounded subshell): survives the
#    caller dying. Needed for post-switch — when ftm runs inside the C-Space
#    display-popup binding, switch-client collapses the popup and tmux HUPs
#    the script's process group before anything after the switch can run.
function run_hook_detached() {
  local event="$1" session="$2" cwd="$3" source="$4"
  local hook="$TMUX_HOOKS/$event.sh"
  [[ -x $hook ]] || return 0
  (FTM_EVENT="$event" FTM_SESSION="$session" FTM_CWD="$cwd" FTM_SOURCE="$source" \
    nohup bash "$hook" "$session" "$cwd" "$source" >/dev/null 2>&1 &)
}

# -- move a session to the top of the MRU state file (source of truth for
#    picker ordering); keeps the newest 50 entries. Lines are "name<TAB>cwd"
#    (cwd may be empty) so dead sessions with a live dir still render.
function bump_recent() {
  local session="$1" cwd="${2:-}" line count=0 tmp
  [[ -n $session ]] || return 0
  mkdir -p "$FTM_STATE_DIR"
  tmp="$recent_file.tmp.$$"
  {
    if [[ -n $cwd ]]; then
      printf '%s\t%s\n' "$session" "$cwd"
    else
      printf '%s\n' "$session"
    fi
    if [[ -f $recent_file ]]; then
      while IFS= read -r line; do
        [[ -z $line || ${line%%"$TAB"*} == "$session" ]] && continue
        printf '%s\n' "$line"
        count=$((count + 1))
        [[ $count -ge 49 ]] && break
      done <"$recent_file"
    fi
  } >"$tmp"
  mv "$tmp" "$recent_file"
}

# -- find the tmux pane id (%N) of the pi agent running in a session.
#    Source of truth: the pi manifest ($PI_STATE_DIR/manifests/
#    pi-{session}-{window}.info, single-line JSON with "pane" and "pid"
#    keys). Falls back to the first pane in the session whose current
#    command is node (pi runs under node).
function pi_pane_for() {
  local session="$1" sid="$2" f json pane pid panes line
  panes="$(tmux list-panes -s -t "$sid" -F '#{pane_id} #{pane_current_command}' 2>/dev/null || true)"
  for f in "$PI_STATE_DIR/manifests/pi-$session-"*.info; do
    [[ -e $f ]] || continue
    [[ $f == *-eph-* ]] && continue
    json="$(<"$f")"
    [[ $json == *'"pane":"'* ]] || continue
    pane="${json#*\"pane\":\"}"
    pane="${pane%%\"*}"
    if [[ $json == *'"pid":'* ]]; then
      pid="${json#*\"pid\":}"
      pid="${pid%%[,\}]*}"
      [[ $pid =~ ^[0-9]+$ ]] && ! kill -0 "$pid" 2>/dev/null && continue
    fi
    [[ $'\n'"$panes" == *$'\n'"$pane "* ]] || continue
    printf '%s' "$pane"
    return 0
  done
  while IFS= read -r line; do
    if [[ ${line#* } == "node" ]]; then
      printf '%s' "${line%% *}"
      return 0
    fi
  done <<<"$panes"
  return 1
}

# -- print a pane capture fitted to the preview window: trailing blank lines
#    stripped (the pi TUI viewport pads with them), then only the newest
#    lines that fit ($FZF_PREVIEW_LINES, exported by fzf) — otherwise fzf
#    renders from the top of the capture and shows stale scrollback instead
#    of the latest pi output.
function print_capture_tail() {
  local target="$1" last=0 i line
  local -a lines=()
  while IFS= read -r line; do
    lines+=("$line")
    [[ -n ${line//[[:space:]]/} ]] && last=${#lines[@]}
  done < <(tmux capture-pane -e -p -S -200 -t "$target" 2>/dev/null || true)
  i=$((last - ${FZF_PREVIEW_LINES:-40}))
  [[ $i -lt 0 ]] && i=0
  while [[ $i -lt $last ]]; do
    printf '%s\n' "${lines[$i]}"
    i=$((i + 1))
  done
}

# -- fzf preview for a picker entry. Running sessions show the newest
#    non-blank lines of the pi agent's pane (capture-pane -e); pi exposes no
#    message-history query over its socket (ping/prompt/tell only), so the
#    rendered pi TUI pane is the closest view of recent pi messages.
#    Sessions without a pi pane fall back to the session's active pane.
#    Dir entries show the path; layout entries show the script.
function preview_entry() {
  local line="$1" name path sid pane
  if [[ $line == *"$TAB"* ]]; then
    path="${line#*"$TAB"}"
    printf '%s%s%s\n' "$C_GRAY" "$path" "$C_RESET"
    return 0
  fi
  name="$(strip_markers "$line")"
  [[ -n $name ]] || return 0
  if sid="$(session_id_for "$name")"; then
    if pane="$(pi_pane_for "$name" "$sid")"; then
      print_capture_tail "$pane"
    else
      print_capture_tail "$sid"
    fi
  elif [[ -n $layouts_dir && -f "$layouts_dir/$name.sh" ]]; then
    cat "$layouts_dir/$name.sh"
  fi
  return 0
}

# -- pre-defined layout names (one glob, no subshells)
function get_layouts() {
  local f
  [[ -n $layouts_dir ]] || return 0
  for f in "$layouts_dir"/*.sh; do
    [[ -e $f ]] || continue
    f="${f##*/}"
    printf '%s\n' "${f%.sh}"
  done
}

# -- print a running-session row: bold name plus a pi status dot (red = pi
#    blocked on a structured question, green = turn done, waiting on user).
#    Reads the asking/done session lists built by print_list.
function print_running() {
  local name="$1"
  if [[ $status_asking == *$'\n'"$name"$'\n'* ]]; then
    printf '%s%s%s %s●%s\n' "$C_BOLD" "$name" "$C_RESET" "$C_RED" "$C_RESET"
  elif [[ $status_done == *$'\n'"$name"$'\n'* ]]; then
    printf '%s%s%s %s●%s\n' "$C_BOLD" "$name" "$C_RESET" "$C_GREEN" "$C_RESET"
  else
    printf '%s%s%s\n' "$C_BOLD" "$name" "$C_RESET"
  fi
}

# -- annotated picker list. Running sessions render bold (non-running
#    entries — layouts and dirs — render dim), plus a
#    colored pi status dot (see print_running) sourced from the agent-status
#    extension's files ($PI_STATE_DIR/status/pi-{session}-{window}.status,
#    "state pid session"). Pure file reads + kill -0 — no subprocesses, so
#    the picker opens instantly. Zoxide entries render as "name<TAB>dimmed
#    path". Ordering: MRU file, then running sessions by last-attached, then
#    zoxide by frecency, then layouts alphabetically.
function print_list() {
  local exclude_current="${1:-}"
  local emitted=$'\n' sess_wrapped=$'\n'
  local s name path line zi mi n f st st_pid st_sess
  local status_asking=$'\n' status_done=$'\n'
  local -a sess_order=() zx_names=() zx_paths=() mru_names=() mru_paths=()

  # pi agent states (dead pids skipped)
  for f in "$PI_STATE_DIR/status"/pi-*.status; do
    [[ -e $f ]] || continue
    IFS=' ' read -r st st_pid st_sess <"$f" || true
    [[ -n $st_sess ]] || continue
    [[ $st_pid =~ ^[0-9]+$ ]] && ! kill -0 "$st_pid" 2>/dev/null && continue
    case $st in
    asking) status_asking+="$st_sess"$'\n' ;;
    done) status_done+="$st_sess"$'\n' ;;
    esac
  done

  # running sessions, most recently attached first
  while IFS= read -r line; do
    s="${line#* }"
    [[ -n $s ]] || continue
    sess_order+=("$s")
    sess_wrapped+="$s"$'\n'
  done < <(tmux list-sessions -F '#{session_last_attached} #{session_name}' 2>/dev/null | sort -rn)

  # top zoxide dirs by frecency
  n=0
  if command -v zoxide &>/dev/null; then
    while IFS= read -r path; do
      [[ $n -ge $FTM_ZOXIDE_LIMIT ]] && break
      [[ -d $path ]] || continue
      zx_names+=("${path##*/}")
      zx_paths+=("$path")
      n=$((n + 1))
    done < <(zoxide query -l 2>/dev/null || true)
  fi

  # MRU entries, most recent first: "name<TAB>cwd" (cwd may be empty)
  if [[ -f $recent_file ]]; then
    while IFS= read -r line; do
      [[ -n $line ]] || continue
      mru_names+=("${line%%"$TAB"*}")
      if [[ $line == *"$TAB"* ]]; then
        mru_paths+=("${line#*"$TAB"}")
      else
        mru_paths+=("")
      fi
    done <"$recent_file"
  fi

  # 1) MRU block — an entry renders as (in priority order): running session,
  #    layout, stored cwd (dir must still exist — killed worktree sessions
  #    land here), zoxide dir; entries resolving to nothing are skipped
  for mi in "${!mru_names[@]}"; do
    name="${mru_names[$mi]}"
    [[ $name == "default" || $name == "$exclude_current" ]] && continue
    [[ $emitted == *$'\n'"$name"$'\n'* ]] && continue
    if [[ $sess_wrapped == *$'\n'"$name"$'\n'* ]]; then
      emitted+="$name"$'\n'
      print_running "$name"
    elif [[ -n $layouts_dir && -f "$layouts_dir/$name.sh" ]]; then
      emitted+="$name"$'\n'
      printf '%s%s%s\n' "$C_DIM" "$name" "$C_RESET"
    elif [[ -n ${mru_paths[$mi]} && -d ${mru_paths[$mi]} ]]; then
      emitted+="$name"$'\n'
      printf '%s%s%s\t%s%s%s\n' "$C_DIM" "$name" "$C_RESET" "$C_GRAY" "${mru_paths[$mi]/#$HOME/\~}" "$C_RESET"
    else
      for zi in "${!zx_names[@]}"; do
        if [[ ${zx_names[$zi]} == "$name" ]]; then
          emitted+="$name"$'\n'
          printf '%s%s%s\t%s%s%s\n' "$C_DIM" "$name" "$C_RESET" "$C_GRAY" "${zx_paths[$zi]/#$HOME/\~}" "$C_RESET"
          break
        fi
      done
    fi
  done

  # 2) remaining running sessions by last-attached
  for name in "${sess_order[@]}"; do
    [[ $name == "default" || $name == "$exclude_current" ]] && continue
    [[ $emitted == *$'\n'"$name"$'\n'* ]] && continue
    emitted+="$name"$'\n'
    print_running "$name"
  done

  # 3) remaining zoxide dirs by frecency (layout name wins → deferred to 4)
  for zi in "${!zx_names[@]}"; do
    name="${zx_names[$zi]}"
    [[ -z $name || $name == "default" || $name == "$exclude_current" ]] && continue
    [[ $emitted == *$'\n'"$name"$'\n'* ]] && continue
    [[ -n $layouts_dir && -f "$layouts_dir/$name.sh" ]] && continue
    emitted+="$name"$'\n'
    printf '%s%s%s\t%s%s%s\n' "$C_DIM" "$name" "$C_RESET" "$C_GRAY" "${zx_paths[$zi]/#$HOME/\~}" "$C_RESET"
  done

  # 4) remaining layouts (glob order = alphabetical)
  while IFS= read -r name; do
    [[ -z $name || $name == "default" || $name == "$exclude_current" ]] && continue
    [[ $emitted == *$'\n'"$name"$'\n'* ]] && continue
    emitted+="$name"$'\n'
    printf '%s%s%s\n' "$C_DIM" "$name" "$C_RESET"
  done < <(get_layouts)
}

# -- change to the given existing session. MRU write and the post-switch hook
#    launch happen BEFORE the switch: inside the C-Space display-popup
#    binding, switch-client collapses the popup and tmux HUPs this script, so
#    nothing after the switch is guaranteed to run.
function to_session() {
  local session sid spath
  session="$(strip_markers "$1")"
  sid="$(session_id_for "$session")" || return 1
  spath="$(tmux display-message -p -t "$sid" '#{session_path}' 2>/dev/null || true)"
  bump_recent "$session" "$spath"
  run_hook_detached post-switch "$session" "$spath" "session"
  tmux "$change" -t "$sid" ';' refresh-client
}

# -- new session with pre-defined layout, OR just new basic tmux session.
#    Fires pre-create/post-create hooks around the build.
function new_session() {
  local session="$1" cwd="$2" source="${3:-default}"

  [[ -n $layouts_dir && -f "$layouts_dir/$session.sh" ]] && source="layout"

  run_hook pre-create "$session" "$cwd" "$source"

  if [[ $source == "layout" ]]; then
    bash "$layouts_dir/$session.sh" ||
      tmux new-session -d -s "$session" -c "$cwd"
  elif [[ -n $layouts_dir && -f "$layouts_dir/default.sh" ]]; then
    bash "$layouts_dir/default.sh" "$session" "$cwd" ||
      tmux new-session -d -s "$session" -c "$cwd"
  else
    tmux new-session -d -s "$session" -c "$cwd"
  fi

  run_hook post-create "$session" "$cwd" "$source"

  to_session "$session"
}

# -- try to change to an existing session; otherwise, create a new one
function try_session() {
  local session cwd source line
  # first non-empty line of fzf output (query or selection)
  session="" cwd="" source="default"
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    if [[ $line == *$TAB* ]]; then
      # zoxide entry: "name<TAB>path" (~ shortened for display)
      session="${line%%"$TAB"*}"
      cwd="${line#*"$TAB"}"
      cwd="${cwd/#\~/$HOME}"
      source="zoxide"
    else
      session="$(strip_markers "$line")"
    fi
    break
  done <<<"$1"
  [[ -n $session ]] || exit 0

  if [[ -z $cwd ]]; then
    cwd=$(zoxide query "$session" 2>/dev/null || true)
    [[ -n $cwd ]] && source="zoxide"
  fi

  # backup plan: use code dir if zoxide finds nothing
  if [[ -z "$cwd" ]]; then
    cwd="$HOME/code"
    source="default"
  fi

  to_session "$session" 2>/dev/null || new_session "$session" "$cwd" "$source"
}

function fuzzy_find() {
  local current_session sessions_count fzf_list
  local fzf_prompt_text fzf_header_text selected_session
  declare -a fzf_extra_args=()

  current_session="$(tmux display-message -p '#S')"
  fzf_list="$(print_list "$current_session")"

  sessions_count=0
  while IFS= read -r _; do sessions_count=$((sessions_count + 1)); done \
    < <(tmux list-sessions -F '#S' 2>/dev/null || true)

  if [[ $sessions_count -le 1 ]]; then
    fzf_prompt_text=" create new session  "
    fzf_header_text="󰢩 recent dirs & layouts"
  else
    fzf_prompt_text=" new or existing session  "
    fzf_header_text="󰢩 ${C_ITALIC}${C_MAGENTA}${current_session}${C_RESET} [${C_WHITE}ctrl-k${C_RESET}: ${C_GRAY}kill / ${C_WHITE}ctrl-r${C_RESET}: ${C_GRAY}rename${C_RESET}]"
  fi

  # -- picker actions; reload regenerates the annotated list so markers stay correct
  # shellcheck disable=SC2016 # fzf action templates: {} and $() expand in fzf's shell, not here
  # "=" prefix forces exact session-name match (names like .dotfiles-... otherwise
  # trip tmux's target parser, which treats a leading dot as a window separator)
  local kill_action='execute-silent(tmux-kill-session "$(printf %s {} | sed -E "s/\t.*$//; s/ ●$//")")+reload(ftm --list)' \
    rename_action='execute(session=$(printf %s {} | sed -E "s/\t.*$//; s/ ●$//"); printf >&2 "New session name: "; read -r name; tmux rename-session -t "$(ftm --id="$session")" "${name}")+reload(ftm --list)'

  # native fzf tmux popup unless we're already inside one (-p)
  [[ $POPUP == "true" ]] || fzf_extra_args+=(--tmux "center,70%,75%")

  selected_session="$(
    fzf \
      ${fzf_extra_args[@]+"${fzf_extra_args[@]}"} \
      --height=100% \
      --ansi \
      --reverse \
      --border=none \
      --scrollbar="▌▐" \
      --padding="1" \
      --prompt="${fzf_prompt_text}" \
      --header="${fzf_header_text}" \
      --color="bg:#3c474d,bg+:#323d43,preview-bg:#262b31" \
      --preview="ftm --preview={}" \
      --preview-window="down,65%,nowrap" \
      --with-shell="bash -c" \
      --bind="change:first" \
      --bind="?:toggle-preview" \
      --bind="ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down" \
      --bind="ctrl-k:${kill_action}" \
      --bind="ctrl-x:${kill_action}" \
      --bind="ctrl-r:${rename_action}" \
      --bind="enter:replace-query+print-query" \
      --pointer='▌' \
      --marker='󰛄' \
      --print-query \
      --exit-0 <<<"$fzf_list"
  )"

  try_session "$selected_session"
}

while getopts "phs:-:" OPTION; do
  case $OPTION in
  p)
    export TMUX_POPUP=1
    POPUP="true"
    ;;
  h)
    __help
    ;;
  s)
    echo "Saving session with session name: $OPTARG"
    exit 0
    ;;
  -)
    case "$OPTARG" in
    list)
      # internal: annotated list for fzf reload binds
      print_list "$(tmux display-message -p '#S' 2>/dev/null || true)"
      exit 0
      ;;
    id=*)
      # internal: session name -> id for picker actions
      session_id_for "${OPTARG#id=}"
      exit $?
      ;;
    preview=*)
      # internal: fzf preview for a picker entry
      preview_entry "${OPTARG#preview=}"
      exit 0
      ;;
    help) __help ;;
    *)
      echo "Invalid Option: --$OPTARG" 1>&2
      exit 1
      ;;
    esac
    ;;
  \?)
    echo "Invalid Option: -$OPTARG" 1>&2
    exit 1
    ;;
  :)
    echo "Invalid Option: -$OPTARG requires an argument" 1>&2
    exit 1
    ;;
  esac
done
shift "$((OPTIND - 1))"

# -- this is our given session_name param, sans options
session_name="${1:-}"

[[ -n $TMUX ]] && change="switch-client" || change="attach-session"

# -- if we pass in a session_name: attach/switch to it or, create new session
if [[ $session_name ]]; then
  try_session "$session_name"
  exit 0
elif [[ -z $TMUX ]]; then
  __help
fi

fuzzy_find
