#!/usr/bin/env bash
# tmux-process-name — icon + smart window name for tmux automatic-rename
# and pane titles. Combines the old ps-based process detection with the
# icon + worktree-aware naming approach from nicknisi's tmux-smart-name
# (nicknisi/dotfiles bin/tmux-smart-name + bin/nerdwin, itself based on
# joshmedeski/tmux-nerd-font-window-name).
#
# Usage: tmux-process-name COMMAND PATH TTY
#   COMMAND  #{pane_current_command}   (avoids ps in the common case)
#   PATH     #{pane_current_path}
#   TTY      #{pane_tty}
# Legacy:  tmux-process-name [TTY]     (old single-arg form; still works
#          so a live tmux server keeps sane names until config reload)
#
# Output: "<icon> <name>" where icon identifies the process and name is
# the directory — worktree-aware: paths under <project>/.worktrees/<wt>
# render as "project (branch)".

# shellcheck disable=SC2009  # ps|grep is intentional: pgrep can't filter by tty
set -euo pipefail

COMMAND="${1:-}"
CUR_PATH="${2:-}"
PANE_TTY="${3:-}"

# -- legacy single-arg (tty) / no-arg invocation: resolve the foreground
#    process from ps like the old script did
if [[ -z $COMMAND || $COMMAND == /dev/* ]]; then
  PANE_TTY="${COMMAND:-$(tty 2>/dev/null || echo '')}"
  CUR_PATH=""
  COMMAND=""
  if [[ -n $PANE_TTY ]]; then
    # foreground process (STAT contains '+') so background children of
    # agents (MCP servers etc.) don't win
    fg_line=$(ps -t "${PANE_TTY#/dev/}" -o stat=,comm= 2>/dev/null | grep '^[^TXZ ]*+' | head -1 || echo "")
    COMMAND="${fg_line#* }"
    COMMAND="${COMMAND##*/}"
  fi
  [[ -n $COMMAND ]] || COMMAND="shell"
fi

# -- pi ships as a node shim, so tmux reports pane_current_command as
#    "node". pi sets its process title to "pi" (Node process.title), which
#    ps -o comm= exposes. Degrades gracefully: no tty / ps failure /
#    non-pi node falls through to the node path.
if [[ $COMMAND == node && -n $PANE_TTY ]]; then
  if ps -t "${PANE_TTY#/dev/}" -o comm= 2>/dev/null | grep -qx pi; then
    COMMAND="pi"
  fi
fi

# -- ssh keeps its old "ssh:host" naming; more useful than the local dir
if [[ $COMMAND == ssh && -n $PANE_TTY ]]; then
  cmd_args=$(ps -t "${PANE_TTY#/dev/}" -o stat=,args= 2>/dev/null | grep '^[^TXZ ]*+' | head -1 || echo "")
  if [[ $cmd_args =~ ssh[[:space:]]+([^[:space:]]+@)?([^[:space:]]+) ]]; then
    echo "󰣀 ${BASH_REMATCH[1]:-}${BASH_REMATCH[2]}"
    exit 0
  fi
fi

# -- icon map (nerdwin-style; pi gets π so it stands out from plain node)
get_icon() {
  case $COMMAND in
  tmux) echo "" ;;
  htop | top | btop) echo "" ;;
  fish | zsh | bash | sh | tcsh | shell) echo "" ;;
  vi | vim | nvim | lvim) echo "" ;;
  lazygit | git | tig | jj) echo "" ;;
  pi) echo "π" ;;
  fleet) echo "☰" ;;
  node) echo "󰎙" ;;
  ruby) echo "" ;;
  go) echo "" ;;
  beam | beam.smp) echo "" ;;
  rustc | rustup | cargo) echo "" ;;
  python* | Python) echo "" ;;
  docker | docker-compose) echo "" ;;
  *) echo "$COMMAND" ;; # no icon: show the command itself
  esac
}

# -- smart directory name: <project>/.worktrees/<wt>/... renders as
#    "project (branch)"; anything else is the plain basename
get_smart_name() {
  local path="$1" project wt branch
  [[ -n $path ]] || return 0
  if [[ $path == */.worktrees/* ]]; then
    project="${path%%/.worktrees/*}"
    project="${project##*/}"
    wt="${path#*/.worktrees/}"
    wt="${wt%%/*}"
    branch="$(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    [[ -n $branch && $branch != HEAD ]] || branch="$wt"
    echo "$project ($branch)"
  else
    echo "${path##*/}"
  fi
}

ICON=$(get_icon)
NAME=$(get_smart_name "$CUR_PATH")

if [[ -n $NAME ]]; then
  echo "$ICON $NAME"
else
  # legacy path (no cwd available): icon alone, or command when unmapped
  echo "$ICON"
fi
