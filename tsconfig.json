{
  // Typechecks the Pi extensions, skill scripts, and Bun suites against the
  // pinned Pi packages in package.json. Pi aliases those packages to its own
  // copies at runtime, so the pin must track the installed Pi version.
  // tmux-golden-layout is a separate project with its own tsconfig.
  "include": ["home/.pi/**/*.ts", "config/mise/tmpls/elixir/tests/**/*.ts"],
  "exclude": [
    "node_modules",
    "home/.pi/agent/extensions/_*",
    "home/.pi/agent/skills/_*",
    "home/.pi/agent/prompts/_*",
    "home/.pi/agent/agents/_*",
    "home/.pi/disabled",
    "home/.pi/patches",
    "home/.pi/tests/.pidewave-extension-*"
  ],
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "types": ["bun"],

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
