#!/usr/bin/env bash
# Compile config/notiwatchd/notiwatchd.swift to a stably-signed binary
# at ~/.dotfiles/bin/notiwatchd (gitignored build artifact).
#
# Signing: prefers a Developer ID Application identity (override with
# NOTIWATCHD_CODESIGN_IDENTITY) with a fixed identifier. TCC pins grants to
# cert + identifier, so Full Disk Access survives rebuilds. Falls back to
# ad-hoc signing (grant re-approval needed after every rebuild) when no
# identity exists.
set -euo pipefail

SRC="${DOTFILES:-$HOME/.dotfiles}/config/notiwatchd/notiwatchd.swift"
OUT="${DOTFILES:-$HOME/.dotfiles}/bin/notiwatchd"
IDENTIFIER="com.megadots.notiwatchd"

IDENTITY="${NOTIWATCHD_CODESIGN_IDENTITY:-}"
if [[ -z "$IDENTITY" ]]; then
  IDENTITY="$(security find-identity -v -p codesigning 2>/dev/null \
    | sed -n 's/.*"\(Developer ID Application: [^"]*\)".*/\1/p' | head -1)"
fi

mkdir -p "$(dirname "$OUT")"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

echo "compiling $SRC ..."
# Nix shells export SDKROOT/DEVELOPER_DIR pointing at the nix apple-sdk, which
# mismatches the system Swift toolchain. Force the Xcode CLT SDK.
unset SDKROOT DEVELOPER_DIR
SDKROOT="$(/usr/bin/xcrun --sdk macosx --show-sdk-path)"
export SDKROOT
/usr/bin/xcrun swiftc -O -o "$TMP/notiwatchd" "$SRC"
if [[ -n "$IDENTITY" ]]; then
  echo "signing with: $IDENTITY (identifier $IDENTIFIER)"
  codesign -f --timestamp --options runtime -i "$IDENTIFIER" -s "$IDENTITY" "$TMP/notiwatchd"
else
  echo "warning: no Developer ID identity found; ad-hoc signing (TCC grant will not survive rebuilds)" >&2
  codesign -f -i "$IDENTIFIER" -s - "$TMP/notiwatchd"
fi
mv -f "$TMP/notiwatchd" "$OUT"
echo "built $OUT"
echo "grant Full Disk Access to it once: System Settings > Privacy & Security > Full Disk Access"
echo "restart agent:"
echo "  launchctl kickstart -k gui/$(id -u)/dev.mise.com.megadots.notiwatchd"
