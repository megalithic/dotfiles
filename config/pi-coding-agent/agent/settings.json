  "terminal": {
    "showTerminalProgress": true,
    "imageWidthCells": 120
  },
  "shellCommandPrefix": "export GIT_MERGE_AUTOEDIT=no\nGIT_EDITOR=true\nexport GIT_SEQUENCE_EDITOR=true\nexport GIT_TERMINAL_PROMPT=0\nexport PI_TMUX_IMAGES=1",
  "multiSub": {
    "subscriptions": [
      {
        "provider": "openai-codex",
        "alias": "openai-codex",
        "label": "openai-codex"
      },
      {
        "provider": "openai-codex",
        "alias": "my-codex",
        "label": "my-codex"
      }
    ],
    "pools": [
      {
        "name": "codex-pool",
        "baseProvider": "my-codex",
        "members": ["openai-codex", "my-codex"],
        "enabled": true
      }
    ],
    "chains": [],
    "presets": [
      {
        "name": "mega",
        "entries": [
          {
            "provider": "my-codex",
            "model": "gpt-5.6-sol",
            "enabled": true
          },
          {
            "provider": "my-codex",
            "model": "gpt-5.6-terra",
            "enabled": true
          },
          {
            "provider": "my-codex",
            "model": "gpt-5.6-luna",
            "enabled": true
          }
        ],
        "enabled": true
      },
      {
        "name": "alt",
        "entries": [
          {
            "provider": "anthropic",
            "model": "claude-fable-5",
            "enabled": true
          },
          {
            "provider": "anthropic",
            "model": "claude-opus-5",
            "enabled": true
          },
          {
            "provider": "anthropic",
            "model": "claude-sonnet-5",
            "enabled": true
          },
          {
            "provider": "anthropic",
            "model": "claude-haiku-4-5",
            "enabled": true
          },
          {
            "provider": "openai-codex",
            "model": "gpt-5.6-sol",
            "enabled": true
          },
          {
            "provider": "openai-codex",
            "model": "gpt-5.6-terra",
            "enabled": true
          },
          {
            "provider": "openai-codex",
            "model": "gpt-5.6-luna",
            "enabled": true
          }
        ],
        "enabled": true
      }
    ],
    "directoryProfiles": [
      {
        "glob": "~/code/work/strive/**",
        "preset": "alt",
        "modelScope": "alt"
      }
    ]
  }
}
