  "subagentRouting": {
    "mega": {
      "worker": {
        "model": "opencode-go/gpt-5.6-luna",
        "thinking": "medium"
      },
      "researcher": {
        "model": "opencode-go/gpt-5.6-luna",
        "thinking": "medium"
      },
      "scout": {
        "model": "opencode-go/gpt-5.6-luna",
        "thinking": "medium"
      }
    },
    "alt": {
      "worker": {
        "model": "anthropic/claude-sonnet-5",
        "thinking": "medium"
      },
      "researcher": {
        "model": "anthropic/claude-sonnet-5",
        "thinking": "medium"
      },
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "medium"
      }
    }
