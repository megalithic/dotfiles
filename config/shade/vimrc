" Shade's vim keys, in Obsidian vimrc-plugin syntax (not read by nvim).
" Shade reads ~/notes/.obsidian.vimrc first when it exists, else this file.
" Translated from config/nvim/lua/keymaps.lua (leader ",", localleader Space).

" Yank, delete and put share the macOS clipboard, like nvim's clipboard=unnamedplus.
set clipboard=unnamedplus

" Leader "," and localleader Space, as in nvim. unmap , first, or , stays f/t's reverse repeat.
" ,w and Space w write (in Tell :w doesn't send, :wq does); ,q hides and keeps the draft.
unmap <Space>
unmap ,
let mapleader = ","
imap jk <Esc>
nmap <leader>w :w<CR>
nmap <leader>q :q<CR>
nmap <Space>w :w<CR>

" Colours: circadia-forest dark, Warm Parchment light, following macOS.
colorscheme circadia-forest

" Moves over wrapped rows; H/L to the first and last non-blank, 0 to the first.
nmap j gj
nmap k gk
nnoremap H ^
nnoremap L g_
vnoremap H ^
vnoremap L g_
nnoremap 0 ^

" Searches and page moves keep the cursor centred.
nnoremap n nzz
nnoremap N Nzz
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz

" Deletes and changes don't clobber the unnamed register.
nnoremap x "_x
nnoremap X "_X
nnoremap D "_D
nnoremap C "_C
nnoremap cc "_cc
vnoremap x "_x
vnoremap c "_c
" Pasting over a selection keeps what you yanked.
vnoremap p "_dP

" Tab jumps between matching pairs.
nmap <Tab> %

" Blank line below or above, staying in normal mode.
nmap <Space>o o<Esc>
nmap <Space>O O<Esc>

" Select the whole buffer.
nnoremap gV ggVG
nnoremap <leader>v ggVG

" Ctrl-n hides Shade, as it toggles Shade from nvim.
nmap <C-n> :q<CR>
imap <C-n> <Esc>:q<CR>
