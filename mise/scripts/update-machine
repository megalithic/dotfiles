#!/usr/bin/env bash
# Run named machine-update phases with direct terminal output.
set -euo pipefail

usage() {
  cat <<'EOF'
usage: update-machine [--dry-run]

Runs each machine-update phase in order. --dry-run asks mise to print each task
without running it.
EOF
}

dry_run=0
case "${1:-}" in
  "") ;;
  --dry-run|-n) dry_run=1 ;;
  --help|-h) usage; exit 0 ;;
  *) printf 'update-machine: unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
esac
[[ "$#" -le 1 ]] || { usage >&2; exit 2; }

phases=(
  update:tools
  update:packages
  update:dotfiles
  install:fonts
  update:system
  update:nvim
  update:fnox
  update:pi
  reload:hammerspoon
)

printf 'mise up\n'
if [[ "$dry_run" -eq 1 ]]; then
  printf 'mode: dry-run\n'
fi

for task in "${phases[@]}"; do
  command=(mise run "$task")
  if [[ "$dry_run" -eq 1 ]]; then
    command=(mise run --dry-run "$task")
  fi
  printf -v command_text '%q ' "${command[@]}"
  command_text="${command_text% }"

  printf '\n==> %s\n' "$task"
  printf 'command: %s\n' "$command_text"

  if "${command[@]}" 2>&1; then
    status=0
  else
    status=$?
  fi
  printf 'exit: %d\n' "$status"

  if [[ "$status" -ne 0 ]]; then
    printf 'FAILED: %s (exit %d)\n' "$task" "$status" >&2
    exit "$status"
  fi
done

printf '\nAll phases completed.\n'
