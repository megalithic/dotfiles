#!/usr/bin/env bash
# Launchd entrypoint: run mise-installed llama-server in router mode.
# Per-model settings (context, sampling, MTP drafts) live in the preset file;
# flags passed here would override every preset, so only router flags go here.
set -euo pipefail

data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/llama.cpp"
llama_server="${XDG_DATA_HOME:-$HOME/.local/share}/mise/installs/llama-cpp/latest/llama-server"
preset="$HOME/.dotfiles/tools/llama-cpp/models.ini"
mkdir -p "$data_dir/models" "$HOME/Library/Logs/llama-cpp"
[[ -x "$llama_server" ]] || {
  echo "llama-server-launchd: installed binary not found: $llama_server" >&2
  exit 127
}
[[ -f "$preset" ]] || {
  echo "llama-server-launchd: model preset not found: $preset" >&2
  exit 1
}

# Preset paths (model-draft) are relative to the data dir.
cd "$data_dir"
exec "$llama_server" \
  --host 127.0.0.1 \
  --port 18080 \
  --models-dir "$data_dir/models" \
  --models-preset "$preset" \
  --models-max 1
