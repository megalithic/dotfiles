--- a/src/system/packages/brew/pour.rs
+++ b/src/system/packages/brew/pour.rs
@@ -296,7 +296,24 @@
             return false;
         }
     };
-    let resolved = crate::file::desymlink_path(&dest.parent().unwrap().join(target));
+    // Normalize the joined path lexically instead of resolving it through
+    // the filesystem: a keg's dylib alias (libfoo.dylib -> libfoo.1.dylib)
+    // has a bare relative symlink target, which read_link + canonicalize
+    // resolves against the process CWD and fails — misjudging every
+    // brew-linked library alias as a foreign file. The check's intent is
+    // "does the immediate target point into our Cellar or opt", which is a
+    // lexical question.
+    let joined = dest.parent().unwrap().join(target);
+    let mut resolved = PathBuf::new();
+    for comp in joined.components() {
+        match comp {
+            std::path::Component::CurDir => {}
+            std::path::Component::ParentDir => {
+                resolved.pop();
+            }
+            c => resolved.push(c),
+        }
+    }
     resolved.starts_with(prefix::cellar()) || resolved.starts_with(prefix::prefix().join("opt"))
 }
 
