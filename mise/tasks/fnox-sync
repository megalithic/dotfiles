#!/usr/bin/env bash
#
# Refresh the local age-encrypted fnox secret cache from 1Password.
#
# Usage:
#   mise run fnox:sync   (or: ~/.dotfiles/mise/tasks/fnox-sync)
#
# Builds a staged ~/.config/fnox/config.toml from shared config (via fnox-setup
# without its standalone source checks), resolves every onepass-backed secret
# once, writes age-encrypted `sync` entries, verifies them, then atomically
# activates the result. Fnox resolves from the cache offline until
# the next sync. Finishes by re-rendering the
# s3cmd config from the cached DO Spaces values. Re-run after rotating
# secrets or changing op:// references in the shared config.
set -euo pipefail

ok() { printf '\033[0;32m[OK]\033[0m %s\n' "$1"; }
fail() {
  printf '\033[0;31m[ERROR]\033[0m %s\n' "$1" >&2
  exit 1
}

[[ "$#" -eq 0 ]] || fail "fnox:sync accepts no arguments"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fnox_dir="${XDG_CONFIG_HOME:-$HOME/.config}/fnox"
config_target="$fnox_dir/config.toml"
staged=""

cleanup() {
  if [[ -n "$staged" && -f "$staged" ]]; then
    : >"$staged"
    if [[ -x /usr/bin/trash ]]; then
      /usr/bin/trash "$staged"
    else
      trash "$staged"
    fi
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

mkdir -p "$fnox_dir"
umask 077
staged="$(mktemp "$fnox_dir/config.toml.sync.XXXXXX")"

# Build and sync a staging config so a transient source failure cannot destroy
# the last valid offline cache.
"$script_dir/fnox-setup" --skip-source-verify --config-target "$staged"
echo

fnox sync --config "$staged" --provider agecache --source onepass --force
ok "Synced 1Password secrets to the staged age cache"

fnox get APPLE_TEAM_ID --config "$staged" >/dev/null
ok "fnox resolved APPLE_TEAM_ID from the refreshed cache"

chmod 600 "$staged"
mv "$staged" "$config_target"
staged=""
ok "Activated refreshed fnox config: $config_target"

"$script_dir/render-s3cfg"
