#!/usr/bin/env bash
# Launchd entrypoint: run the mise-installed kanata-bar UI client.
# Resolves the versioned http:kanata-bar install path so version bumps in
# mise/config/mise/global_config.toml [tools] do not require launchd agent edits.
set -euo pipefail
# ~/.local/bin first: the standalone mise binary lives there (not in shims),
# and launchd's minimal environment otherwise cannot resolve the active install.
export PATH="$HOME/.local/bin:${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims:/opt/homebrew/bin:/usr/bin:/bin:$PATH"

app_bin=""
if command -v mise >/dev/null 2>&1; then
  install_path="$(mise where http:kanata-bar 2>/dev/null || true)"
  if [[ -n "$install_path" && -x "${install_path}/Kanata Bar.app/Contents/MacOS/kanata-bar" ]]; then
    app_bin="${install_path}/Kanata Bar.app/Contents/MacOS/kanata-bar"
  fi
fi

if [[ -z "$app_bin" ]]; then
  candidate="${XDG_DATA_HOME:-$HOME/.local/share}/mise/installs/http-kanata-bar/latest/Kanata Bar.app/Contents/MacOS/kanata-bar"
  if [[ -x "$candidate" ]]; then
    app_bin="$candidate"
  fi
fi

if [[ -z "$app_bin" ]]; then
  echo "kanata-bar-launchd: kanata-bar not found; run: mise install http:kanata-bar" >&2
  exit 1
fi

exec "$app_bin" --config-file "$HOME/.config/kanata-bar/config.toml"
