#!/usr/bin/env bash
# Render file-shaped fnox secrets generically (fnox twin of the opnix render
# step). Invoked via `mise run setup:fnox:render`; iterates `fnox list` so new
# [secrets] entries render without editing this script.
#
# Rules:
#   - the case statement in the render loop maps specific keys to destination
#     paths (S3CFG -> ~/.s3cfg).
#   - every other key ending in _SH renders to
#     ~/.config/fnox/secrets/<key minus _SH, lowercased, _ -> ->.sh
#     (ENV_VARS_SH -> env-vars.sh). fish conf.d/fnox.fish sources every *.sh
#     in that dir, so new *_SH secrets flow into shells automatically.
#   - anything else (on-demand `fnox get` values, env=false scalars) is skipped.
#
# Resolution failures warn and skip so bootstrap continues (e.g. work machine
# without the personal 1Password account, or a locked 1Password app). Each
# resolve is wrapped in a timeout when GNU timeout is available, because a
# locked 1Password app makes `op` block on biometric approval indefinitely.
set -euo pipefail

secrets_dir="${XDG_CONFIG_HOME:-$HOME/.config}/fnox/secrets"
umask 077
mkdir -p "$secrets_dir"

# No associative arrays: bash 3.2 lacks them entirely, and bash 5.3 evaluates
# their subscripts under `set -u`. mise may run this under either, so key->path
# mapping lives in the case statement below.

timeout_cmd=()
if command -v timeout >/dev/null 2>&1; then
  timeout_cmd=(timeout 60)
elif command -v gtimeout >/dev/null 2>&1; then
  timeout_cmd=(gtimeout 60)
fi

skipped=0

# Printed whenever any secret fails to resolve. Keep these steps in sync with
# the "op / 1Password / fnox failure runbook" section in AGENTS.md.
print_runbook() {
  cat >&2 <<'RUNBOOK'

== op / 1Password / fnox failure runbook ==
1. op whoami
   - Works: op is fine; problem is fnox config or the vault item.
2. Error mentions settings.json "operation not permitted":
   macOS TCC attribution broke — a brew upgrade replaced Ghostty/1Password
   under running processes. Fix:
   a. Quit and relaunch Ghostty (loads the new binary).
   b. tmux kill-server, then start tmux fresh from the new Ghostty.
   c. pkill -f 'op daemon'
   d. Rerun op whoami; Allow any "access data from other apps" prompt.
3. "No accounts configured":
   1Password app must be running and unlocked, with
   Settings > Developer > "Integrate with 1Password CLI" enabled.
4. GUI-independent fallback: plug in the YubiKey, then
   export OP_SERVICE_ACCOUNT_TOKEN="$(fnox get OP_SERVICE_ACCOUNT_TOKEN)"
   First-time hardware setup: mise run setup:yubikey
5. Verify: fnox get APPLE_TEAM_ID, then mise run setup:fnox:render
RUNBOOK
}

render_one() {
  local key="$1" dest="$2" tmp err
  tmp="$(mktemp "$(dirname "$dest")/.$(basename "$dest").XXXXXX")"
  if ! err=$("${timeout_cmd[@]}" fnox get "$key" 2>&1 >"$tmp"); then
    echo "fnox-render-secrets: skip ${key}: ${err:-timed out (1Password locked?)}" >&2
    rm -f "$tmp"
    skipped=$((skipped + 1))
    return 0
  fi
  if [ ! -s "$tmp" ]; then
    echo "fnox-render-secrets: ${key} resolved empty; keeping existing ${dest}" >&2
    rm -f "$tmp"
    skipped=$((skipped + 1))
    return 0
  fi
  chmod 0600 "$tmp"
  mv "$tmp" "$dest"
  echo "rendered ${dest}"
}

# Hardware bootstrap: when the 1Password desktop-app integration is broken or
# absent (clean install, TCC attribution breakage), decrypt the service
# account token with the YubiKey so op works without the GUI. Quietly skipped
# when op already works, the token secret is not configured, or no YubiKey is
# plugged in (age decrypt then fails within the timeout).
if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && ! op whoami >/dev/null 2>&1; then
  if token=$("${timeout_cmd[@]}" fnox get OP_SERVICE_ACCOUNT_TOKEN 2>/dev/null) && [ -n "$token" ]; then
    export OP_SERVICE_ACCOUNT_TOKEN="$token"
    echo "fnox-render-secrets: op bootstrapped via YubiKey service-account token" >&2
  fi
fi

# fnox list column 1, skipping the header row. `fnox list` reads config only —
# it does not resolve providers, so it is safe while 1Password is locked.
keys="$(fnox list 2>/dev/null | awk 'NR > 1 { print $1 }')"
if [ -z "$keys" ]; then
  echo "fnox-render-secrets: no secrets listed; is ~/.config/fnox/config.toml in place?" >&2
  exit 0
fi

for key in $keys; do
  case "$key" in
    # Explicit file targets: KEY) dest ;;
    S3CFG)
      render_one "$key" "$HOME/.s3cfg"
      ;;
    *_SH)
      base="${key%_SH}"
      base="$(printf '%s' "$base" | tr '[:upper:]_' '[:lower:]-')"
      render_one "$key" "${secrets_dir}/${base}.sh"
      ;;
  esac
done

if [ "$skipped" -gt 0 ]; then
  echo "fnox-render-secrets: ${skipped} secret(s) skipped" >&2
  print_runbook
fi
