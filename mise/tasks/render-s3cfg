#!/usr/bin/env bash
# Render the s3cmd config from the sanitized template and fnox DO Spaces
# fields. Runs at the end of `mise run fnox`; values come from the local
# age cache, so no 1Password round-trips are needed. No-ops when unchanged.
set -euo pipefail

config=""
output=""
while [[ "$#" -gt 0 ]]; do
  case "$1" in
  --config)
    [[ "$#" -ge 2 && -n "$2" ]] || {
      echo "render-s3cfg: --config requires a path" >&2
      exit 1
    }
    config="$2"
    shift 2
    ;;
  --output)
    [[ "$#" -ge 2 && -n "$2" ]] || {
      echo "render-s3cfg: --output requires a path" >&2
      exit 1
    }
    output="$2"
    shift 2
    ;;
  *)
    echo "render-s3cfg: unknown argument: $1" >&2
    exit 1
    ;;
  esac
done

command -v fnox &>/dev/null || {
  echo "render-s3cfg: fnox not found. Run 'mise install' first." >&2
  exit 1
}

template="${DOTFILES_DIR:-$HOME/.dotfiles}/config/s3cmd/s3cfg.template"
output="${output:-${XDG_DATA_HOME:-$HOME/.local/share}/fnox/generated/s3cfg}"
output_dir="$(dirname "$output")"
tmp=""

[[ -f "$template" ]] || {
  echo "render-s3cfg: template not found: $template" >&2
  exit 1
}

fnox_get() {
  if [[ -n "$config" ]]; then
    fnox get "$1" --config "$config" --no-daemon
  else
    fnox get "$1"
  fi
}

DO_SPACES_CAPS_KEY="$(fnox_get DO_SPACES_CAPS_KEY)"
DO_SPACES_CAPS_SECRET="$(fnox_get DO_SPACES_CAPS_SECRET)"
DO_SPACES_CAPS_REGION="$(fnox_get DO_SPACES_CAPS_REGION)"
for var in DO_SPACES_CAPS_KEY DO_SPACES_CAPS_SECRET DO_SPACES_CAPS_REGION; do
  [[ -n "${!var}" ]] || {
    echo "render-s3cfg: fnox returned empty $var" >&2
    exit 1
  }
done

cleanup() {
  if [[ -n "$tmp" && -f "$tmp" ]]; then
    : > "$tmp"
    trash "$tmp" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

umask 077
mkdir -p "$output_dir"
chmod 0700 "$output_dir"
tmp="$(mktemp "$output.XXXXXX")"

while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line//'{{DO_SPACES_CAPS_KEY}}'/$DO_SPACES_CAPS_KEY}"
  line="${line//'{{DO_SPACES_CAPS_SECRET}}'/$DO_SPACES_CAPS_SECRET}"
  line="${line//'{{DO_SPACES_CAPS_REGION}}'/$DO_SPACES_CAPS_REGION}"
  printf '%s\n' "$line"
done < "$template" > "$tmp"

if rg -q '\{\{DO_SPACES_CAPS_[A-Z_]+\}\}' "$tmp"; then
  echo "render-s3cfg: unresolved DO Spaces placeholder" >&2
  exit 1
fi

chmod 0600 "$tmp"
if [[ -f "$output" ]] && cmp -s "$tmp" "$output"; then
  : > "$tmp"
  trash "$tmp"
  tmp=""
  echo "render-s3cfg: unchanged $output"
  exit 0
fi

mv "$tmp" "$output"
tmp=""
echo "render-s3cfg: rendered $output"
