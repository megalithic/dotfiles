#!/usr/bin/env bash
#
# One-time (per YubiKey / per token rotation) setup for hardware-backed
# op/fnox bootstrap. Idempotent; safe to re-run.
#
#   1. Verify age-plugin-yubikey is installed and a YubiKey is connected.
#   2. Ensure an age identity exists on the YubiKey (generate into the first
#      empty PIV retired slot if the key has none; never overwrites).
#   3. Write the identity stub to the repo (committable, non-secret) and
#      symlink it to ~/.config/fnox/yubikey-identity.txt.
#   4. Ensure the recipient is in the fnox age provider config.
#   5. Ensure OP_SERVICE_ACCOUNT_TOKEN is stored encrypted (prompts for the
#      ops_... token on first run; create one at 1password.com > Settings >
#      Integrations > Service Accounts with READ access to the Crypt vault).
#   6. Verify the round-trip: decrypt via YubiKey, then `op whoami`.
#
# Usage: mise run setup:yubikey
set -euo pipefail

ok() { echo -e "\033[0;32m[OK]\033[0m $1"; }
skip() { echo -e "\033[0;33m[SKIP]\033[0m $1"; }
fail() {
  echo -e "\033[0;31m[ERROR]\033[0m $1"
  exit 1
}

dotfiles="${DOTFILES_DIR:-$HOME/.dotfiles}"
repo_identity="$dotfiles/mise/config/fnox/yubikey-identity.txt"
home_identity="${XDG_CONFIG_HOME:-$HOME/.config}/fnox/yubikey-identity.txt"
fnox_config="$dotfiles/mise/config/fnox/config.toml"

# -- 1. prerequisites ---------------------------------------------------------
command -v age-plugin-yubikey &>/dev/null ||
  fail "age-plugin-yubikey not found. Run 'mise install' first."
command -v fnox &>/dev/null || fail "fnox not found. Run 'mise install' first."
command -v op &>/dev/null || fail "op not found (brew-cask 1password-cli@beta)."

ioreg -p IOUSB -k "USB Product Name" 2>/dev/null | grep -qi yubikey ||
  fail "No YubiKey connected. Plug it in and re-run."
ok "YubiKey connected"

# -- 2. identity on the key ---------------------------------------------------
# --list is read-only and PIN-less; one line per age identity on the key.
identities="$(age-plugin-yubikey --list 2>/dev/null || true)"
if [[ -z "$identities" ]]; then
  echo "No age identity on this YubiKey yet; generating one (first empty slot)."
  echo "You will be prompted for the PIV PIN (default 123456 forces a change)"
  echo "and a touch."
  [[ -t 0 ]] || fail "Interactive terminal required for PIN/touch prompts."
  age-plugin-yubikey --generate --name fnox-crypt \
    --pin-policy once --touch-policy cached >"$repo_identity"
  ok "Generated identity into $repo_identity"
else
  ok "YubiKey already has an age identity"
  # Regenerate the stub if the repo copy is missing or has no identity line.
  if ! grep -q '^AGE-PLUGIN-YUBIKEY-' "$repo_identity" 2>/dev/null; then
    age-plugin-yubikey --identity >"$repo_identity"
    ok "Regenerated identity stub into $repo_identity"
  fi
fi

recipient="$(grep -io 'age1yubikey1[a-z0-9]*' "$repo_identity" | head -1)"
[[ -n "$recipient" ]] || fail "Could not extract recipient from $repo_identity"
ok "Recipient: $recipient"

# -- 3. symlink into ~/.config/fnox -------------------------------------------
if [[ "$(readlink "$home_identity" 2>/dev/null)" != "$repo_identity" ]]; then
  mkdir -p "$(dirname "$home_identity")"
  ln -sf "$repo_identity" "$home_identity"
  ok "Linked $home_identity -> $repo_identity"
else
  ok "Identity symlink in place"
fi

# -- 4. recipient in fnox config ----------------------------------------------
# Formatting-agnostic: formatters may split `recipients = []` across lines,
# so match the empty array as a multiline regex instead of a literal grep.
if grep -q "$recipient" "$fnox_config"; then
  ok "Recipient already in fnox config"
elif python3 - "$fnox_config" "$recipient" <<'PY'; then
import re, sys
path, rec = sys.argv[1], sys.argv[2]
with open(path) as f:
    s = f.read()
new, n = re.subn(r"recipients\s*=\s*\[\s*\]", f'recipients = ["{rec}"]', s, count=1)
if n == 0:
    sys.exit(1)
with open(path, "w") as f:
    f.write(new)
PY
  ok "Inserted recipient into fnox config"
else
  fail "fnox config has a different recipient (replacement key?).
Update the age provider in $fnox_config to:
  recipients = [\"$recipient\"]
then re-encrypt: fnox reencrypt -p age"
fi

# -- 5. encrypted token in global fnox config ----------------------------------
if python3 - "$fnox_config" <<'PY'
import sys, tomllib
with open(sys.argv[1], "rb") as f:
    data = tomllib.load(f)
secret = data.get("secrets", {}).get("OP_SERVICE_ACCOUNT_TOKEN")
if not isinstance(secret, dict) or secret.get("provider") != "age":
    sys.exit(1)
PY
then
  skip "OP_SERVICE_ACCOUNT_TOKEN already stored in global fnox config (rotate: fnox set -g OP_SERVICE_ACCOUNT_TOKEN --provider age)"
else
  [[ -t 0 ]] || fail "Interactive terminal required to paste the token."
  read -rsp "Paste the ops_... service account token: " token
  echo
  [[ "$token" == ops_* ]] || fail "Token must start with ops_"
  printf '%s' "$token" | fnox set -g OP_SERVICE_ACCOUNT_TOKEN --provider age
  ok "Token stored encrypted in global fnox config (safe to commit)"
fi

python3 - "$fnox_config" <<'PY'
import re, sys, tomllib
path = sys.argv[1]
with open(path) as f:
    s = f.read()
with open(path, "rb") as f:
    data = tomllib.load(f)
secret = data.get("secrets", {}).get("OP_SERVICE_ACCOUNT_TOKEN")
if not isinstance(secret, dict) or secret.get("provider") != "age":
    sys.exit("OP_SERVICE_ACCOUNT_TOKEN missing from global fnox config")
pattern = r'(OP_SERVICE_ACCOUNT_TOKEN\s*=\s*\{[^}\n]*)(\})'

def repl(match):
    line = match.group(0)
    if re.search(r'\benv\s*=', line):
        return re.sub(r'\benv\s*=\s*(true|false)', 'env = false', line, count=1)
    return f'{match.group(1).rstrip()}, env = false {match.group(2)}'

new, n = re.subn(pattern, repl, s, count=1)
if n != 1:
    sys.exit("Could not force env = false for OP_SERVICE_ACCOUNT_TOKEN")
with open(path, "w") as f:
    f.write(new)
PY
ok "OP_SERVICE_ACCOUNT_TOKEN env=false enforced"

# -- 6. verify round-trip -------------------------------------------------------
echo "Verifying decrypt (YubiKey touch may be required).."
token="$(fnox get OP_SERVICE_ACCOUNT_TOKEN)"
[[ -n "$token" ]] || fail "Decryption returned empty token"
ok "Decrypt works"

if OP_SERVICE_ACCOUNT_TOKEN="$token" op whoami &>/dev/null; then
  ok "op authenticates with the service account token"
else
  fail "op rejected the token (revoked? wrong account?). Rotate it at 1password.com."
fi

ok "Done. Commit $repo_identity and mise/config/fnox/config.toml."
