#!/usr/bin/env bash
#
# Configure fnox on a machine that already has mise.
#
# Usage:
#   mise run setup:fnox   (or: ~/.dotfiles/mise/tasks/fnox-setup)
#
# Prerequisites:
#   mise install
#
set -euo pipefail

ok() { printf '\033[0;32m[OK]\033[0m %s\n' "$1"; }
skip() { printf '\033[0;33m[SKIP]\033[0m %s\n' "$1"; }
fail() {
  printf '\033[0;31m[ERROR]\033[0m %s\n' "$1" >&2
  exit 1
}

for cmd in op fnox; do
  command -v "$cmd" &>/dev/null || fail "$cmd not found. Run 'mise install' first."
done

config_source="${DOTFILES_DIR:-$HOME/.dotfiles}/mise/config/fnox/config.toml"
config_target="${XDG_CONFIG_HOME:-$HOME/.config}/fnox/config.toml"

[[ -f "$config_source" ]] || fail "fnox config source not found: $config_source"

if [[ -L "$config_target" && ! -e "$config_target" ]]; then
  fail "fnox config is a dangling symlink: $config_target"
elif [[ -e "$config_target" ]]; then
  skip "fnox config already exists: $config_target"
else
  mkdir -p "$(dirname "$config_target")"
  ln -s "$config_source" "$config_target"
  ok "Linked fnox config: $config_target"
fi

op vault list &>/dev/null || fail "1Password CLI cannot access vaults. Enable 1Password CLI integration, then retry."
ok "1Password CLI can access vaults"

fnox get APPLE_TEAM_ID --config "$config_target" >/dev/null
ok "fnox resolved APPLE_TEAM_ID"
