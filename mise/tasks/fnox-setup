#!/usr/bin/env bash
#
# Configure fnox on a machine that already has mise.
#
# Usage:
#   mise run setup:fnox   (or: ~/.dotfiles/mise/tasks/fnox-setup)
#
# Prerequisites:
#   mise install
#
# Layout:
#   mise/config/fnox/shared.toml  committed source of truth (providers + op:// refs)
#   ~/.config/fnox/config.toml    GENERATED: shared body + per-machine agecache
#                                 provider; `mise run fnox:sync` refreshes it and
#                                 writes age-encrypted sync caches into it
#
# fnox ignores `import` in the auto-loaded global config, so the shared body is
# copied instead of imported. Regenerating drops old sync caches; fnox:sync
# restores them from 1Password.
set -euo pipefail

ok() { printf '\033[0;32m[OK]\033[0m %s\n' "$1"; }
skip() { printf '\033[0;33m[SKIP]\033[0m %s\n' "$1"; }
fail() {
  printf '\033[0;31m[ERROR]\033[0m %s\n' "$1" >&2
  exit 1
}

verify_source=1
config_target=""
while [[ "$#" -gt 0 ]]; do
  case "$1" in
  --skip-source-verify)
    verify_source=0
    shift
    ;;
  --config-target)
    [[ "$#" -ge 2 && -n "$2" ]] || fail "--config-target requires a path"
    config_target="$2"
    shift 2
    ;;
  *) fail "unknown argument: $1" ;;
  esac
done

for cmd in op fnox age-keygen; do
  command -v "$cmd" &>/dev/null || fail "$cmd not found. Run 'mise install' first."
done

fnox_dir="${XDG_CONFIG_HOME:-$HOME/.config}/fnox"
shared_source="${DOTFILES_DIR:-$HOME/.dotfiles}/mise/config/fnox/shared.toml"
config_target="${config_target:-$fnox_dir/config.toml}"
cache_key="$fnox_dir/age-cache-key.txt"

[[ -f "$shared_source" ]] || fail "fnox shared config source not found: $shared_source"
mkdir -p "$fnox_dir"

# Clean up retired layouts: config.toml-as-symlink and the shared.toml link
for legacy in "$config_target" "$fnox_dir/shared.toml"; do
  if [[ -L "$legacy" ]]; then
    rm "$legacy"
    ok "Removed legacy fnox symlink: $legacy"
  fi
done

# Per-machine software age key for the local sync cache
if [[ -f "$cache_key" ]]; then
  skip "age cache key already exists: $cache_key"
else
  (umask 077 && age-keygen -o "$cache_key" &>/dev/null)
  ok "Generated age cache key: $cache_key"
fi
chmod 600 "$cache_key"
cache_recipient="$(age-keygen -y "$cache_key")"
[[ -n "$cache_recipient" ]] || fail "could not derive age recipient from $cache_key"

# Generate the global config: shared body + per-machine agecache provider.
# Always regenerated; sync caches are restored by `mise run fnox:sync`.
umask 077
tmp="$(mktemp "$config_target.XXXXXX")"
{
  # shellcheck disable=SC2016 # Backticks are literal documentation.
  printf '# GENERATED by `mise run setup:fnox` — DO NOT EDIT.\n'
  # shellcheck disable=SC2016 # Backticks are literal documentation.
  printf '# Edit %s and rerun `mise run fnox:sync`.\n\n' "$shared_source"
  cat "$shared_source"
  cat <<EOF

# Per-machine software age key for the local secret cache (fnox sync).
[providers.agecache]
type = "age"
recipients = ["$cache_recipient"]
key_file = "~/.config/fnox/age-cache-key.txt"
EOF
} >"$tmp"
chmod 600 "$tmp"
mv "$tmp" "$config_target"
ok "Generated fnox config: $config_target"

if [[ "$verify_source" == 1 ]]; then
  op vault list &>/dev/null || fail "1Password CLI cannot access vaults. Enable 1Password CLI integration, then retry."
  ok "1Password CLI can access vaults"

  fnox get APPLE_TEAM_ID --config "$config_target" >/dev/null
  ok "fnox resolved APPLE_TEAM_ID"

  echo
  echo "Next: run 'mise run fnox:sync' to cache 1Password secrets locally."
fi
