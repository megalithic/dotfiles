#!/usr/bin/env bash
# Converge fnox config, local age cache, daemon state, and generated artifacts.
#
# Usage:
#   mise run fnox
#
# Builds a staged ~/.config/fnox/config.toml from the committed shared config,
# syncs every declared onepass secret into the local encrypted age cache,
# verifies complete cache coverage, then atomically activates the result.
set -euo pipefail

ok() { printf '\033[0;32m[OK]\033[0m %s\n' "$1"; }
skip() { printf '\033[0;33m[SKIP]\033[0m %s\n' "$1"; }
fail() {
  printf '\033[0;31m[ERROR]\033[0m %s\n' "$1" >&2
  exit 1
}

[[ "$#" -eq 0 ]] || fail "fnox accepts no arguments"

for cmd in op fnox age-keygen trash; do
  command -v "$cmd" &>/dev/null || fail "$cmd not found. Run 'mise install' first."
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fnox_dir="${XDG_CONFIG_HOME:-$HOME/.config}/fnox"
shared_source="${DOTFILES_DIR:-$HOME/.dotfiles}/mise/config/fnox/shared.toml"
config_target="$fnox_dir/config.toml"
cache_key="$fnox_dir/age-cache-key.txt"
artifact_target="${XDG_DATA_HOME:-$HOME/.local/share}/fnox/generated/s3cfg"
staged=""
artifact_staged=""
config_backup=""
artifact_backup=""
config_activated=0
artifact_activated=0
activation_complete=0

wipe_trash() {
  local path="$1"
  [[ -n "$path" && ( -e "$path" || -L "$path" ) ]] || return 0
  [[ -f "$path" && ! -L "$path" ]] && : >"$path"
  trash "$path" >/dev/null 2>&1 || true
}

cleanup() {
  local status=$?
  set +e
  if [[ "$activation_complete" == 0 ]]; then
    if [[ "$artifact_activated" == 1 ]]; then
      if [[ -n "$artifact_backup" && -f "$artifact_backup" ]]; then
        mv -f "$artifact_backup" "$artifact_target"
        artifact_backup=""
      else
        wipe_trash "$artifact_target"
      fi
    fi
    if [[ "$config_activated" == 1 ]]; then
      if [[ -n "$config_backup" && -f "$config_backup" ]]; then
        mv -f "$config_backup" "$config_target"
        config_backup=""
      else
        wipe_trash "$config_target"
      fi
    fi
  fi
  wipe_trash "$staged"
  wipe_trash "$artifact_staged"
  wipe_trash "$config_backup"
  wipe_trash "$artifact_backup"
  return "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

[[ -f "$shared_source" ]] || fail "fnox shared config source not found: $shared_source"
umask 077
mkdir -p "$fnox_dir"

if [[ -L "$fnox_dir/shared.toml" ]]; then
  trash "$fnox_dir/shared.toml"
  ok "Removed legacy fnox shared config symlink"
fi

if [[ -f "$cache_key" ]]; then
  skip "age cache key already exists: $cache_key"
else
  (umask 077 && age-keygen -o "$cache_key" &>/dev/null)
  ok "Generated age cache key: $cache_key"
fi
chmod 600 "$cache_key"
cache_recipient="$(age-keygen -y "$cache_key")"
[[ -n "$cache_recipient" ]] || fail "could not derive age recipient from $cache_key"

op vault list &>/dev/null || fail "1Password CLI cannot access vaults. Enable 1Password CLI integration, then retry."
ok "1Password CLI can access vaults"

staged="$(mktemp "$fnox_dir/config.toml.sync.XXXXXX")"
{
  # shellcheck disable=SC2016 # Backticks are literal documentation.
  printf '# GENERATED by `mise run fnox` - DO NOT EDIT.\n'
  # shellcheck disable=SC2016 # Backticks are literal documentation.
  printf '# Edit %s and rerun `mise run fnox`.\n\n' "$shared_source"
  cat "$shared_source"
  cat <<EOF

# Per-machine software age key for the local secret cache (fnox sync).
[providers.agecache]
type = "age"
recipients = ["$cache_recipient"]
key_file = "~/.config/fnox/age-cache-key.txt"
EOF
} >"$staged"
chmod 600 "$staged"

fnox sync --config "$staged" --provider agecache --source onepass --force --no-daemon
ok "Synced declared 1Password secrets to the staged age cache"

missing_sync="$(awk '
  /^\[secrets\]$/ { in_secrets = 1; next }
  in_secrets && /^\[/ { exit }
  in_secrets && /provider = "onepass"/ {
    count++
    if ($0 !~ /sync =/) {
      key = $0
      sub(/[[:space:]]*=.*/, "", key)
      print key
    }
  }
  END {
    if (count == 0) exit 2
  }
' "$staged")" || fail "could not verify declared 1Password cache entries"
[[ -z "$missing_sync" ]] || fail "missing age cache entries for: ${missing_sync//$'\n'/, }"
ok "Verified every declared 1Password secret has an age cache entry"

fnox get APPLE_TEAM_ID --config "$staged" --no-daemon >/dev/null
ok "Resolved a secret from the refreshed cache"

artifact_dir="$(dirname "$artifact_target")"
mkdir -p "$artifact_dir"
chmod 0700 "$artifact_dir"
artifact_staged="$(mktemp "$artifact_dir/s3cfg.sync.XXXXXX")"
"$script_dir/render-s3cfg" --config "$staged" --output "$artifact_staged"
if [[ -f "$artifact_target" ]] && cmp -s "$artifact_staged" "$artifact_target"; then
  wipe_trash "$artifact_staged"
  artifact_staged=""
  skip "s3cfg artifact is unchanged"
else
  ok "Staged refreshed s3cfg artifact"
fi

if fnox daemon status >/dev/null 2>&1; then
  fnox daemon clear >/dev/null || fail "could not clear the running fnox daemon cache"
  ok "Cleared fnox daemon cache"
else
  skip "fnox daemon is not running; shell hook will load the new config"
fi

if [[ -f "$config_target" || -L "$config_target" ]]; then
  config_backup="$(mktemp "$fnox_dir/config.toml.backup.XXXXXX")"
  cp -p "$config_target" "$config_backup"
fi
if [[ -n "$artifact_staged" && -f "$artifact_target" ]]; then
  artifact_backup="$(mktemp "$artifact_dir/s3cfg.backup.XXXXXX")"
  cp -p "$artifact_target" "$artifact_backup"
fi

chmod 600 "$staged"
mv "$staged" "$config_target"
staged=""
config_activated=1
if [[ -n "$artifact_staged" ]]; then
  mv "$artifact_staged" "$artifact_target"
  artifact_staged=""
  artifact_activated=1
fi
activation_complete=1
wipe_trash "$config_backup"
config_backup=""
wipe_trash "$artifact_backup"
artifact_backup=""
ok "Activated refreshed fnox config and generated artifacts"
ok "Fnox ready; current interactive shell reloads on its next prompt"
