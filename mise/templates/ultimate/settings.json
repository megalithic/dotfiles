{
  "extensions": {
    "enable": [
      "tailscale"
    ],
    "disable": [
      "splash",
      "voice"
    ]
  },
  "fleet": {
    "primary": "~/.dotfiles"
  },
  "modelFamilies": {
    "families": {
      "review": { "model": "openai-codex/gpt-6-astra" }
    }
  },
  "onboarding": false,
  "remotes": {
    "megabookpro": {
      ".dotfiles": "https://megabookpro.{{TAILNET}}:4749"
    },
    "workbookpro": {
      ".dotfiles": "https://workbookpro.{{TAILNET}}:4749"
    }
  },
  "mcpServers": {
    "executor": {
      "url": "http://127.0.0.1:4312/mcp?elicitation_mode=browser",
      "headers": {
        "Authorization": "Bearer ${EXECUTOR_API_KEY}"
      }
    },
    "web": {
      "command": "node",
      "args": [
        "/Users/seth/.pi/agent/npm/node_modules/pi-web-access/dist/mcp-cli.js"
      ]
    },
    "sessions": {
      "command": "/Users/seth/.local/share/mise/shims/sessions",
      "args": [
        "--mcp"
      ]
    }
  }
}
