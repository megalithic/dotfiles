# Shared ssh config for all hosts. Included by config.<hostname> files, which
# are mapped to ~/.ssh/config per-host via mise/config/mise/hosts/*.toml.
#
# NOTE:
# In the event you're unable to push:
# ssh -T git@github.com
# then, likely:
# chmod 0600 ~/.ssh/config

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Host github.com gh
  Hostname github.com
  User git
  StrictHostKeyChecking no
  UserKnownHostsFile=/dev/null
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  BatchMode yes
  PasswordAuthentication no
  ControlMaster auto
  ControlPersist 120
  LogLevel QUIET
  ForwardAgent yes

# LAN: both laptops can ssh to each other (requires Remote Login enabled on
# the target machine). Own-host entry is harmless locally.
Host megabookpro megabookpro.local
  Hostname megabookpro.local
  User seth
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  IdentitiesOnly yes
  IdentityFile "~/.ssh/id_ed25519.pub"
  PreferredAuthentications publickey
  BatchMode yes
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  StrictHostKeyChecking accept-new
  ControlMaster auto
  ControlPersist 120

Host workbookpro workbookpro.local
  Hostname workbookpro.local
  User seth
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  IdentitiesOnly yes
  IdentityFile "~/.ssh/id_ed25519.pub"
  PreferredAuthentications publickey
  BatchMode yes
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  StrictHostKeyChecking accept-new
  ControlMaster auto
  ControlPersist 120

# DigitalOcean droplet
Host 198.199.91.123
  Hostname 198.199.91.123
  User replicant
  StrictHostKeyChecking no
  UserKnownHostsFile=/dev/null
  # IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  IdentityFile "~/.ssh/id_ed25519"
  BatchMode yes
  PasswordAuthentication no
  ControlMaster auto
  ControlPersist 120
  LogLevel QUIET

# Host megalithic.dev ocean
#   HostName megalithic.dev
#   User replicant
#   ControlPath /tmp/ssh_mux_%r@%h:%p
#   IdentityFile ~/.ssh/seth-megabookpro
