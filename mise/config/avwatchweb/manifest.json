{
  "manifest_version": 3,
  "name": "avwatchweb",
  "version": "1.0.0",
  "description": "Private media state bridge for avwatchd.",
  "key": "",
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["main-hook.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["http://*/*", "https://*/*"], "js": ["bridge.js"], "run_at": "document_start", "world": "ISOLATED" }
  ],
  "permissions": ["nativeMessaging", "tabs", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
