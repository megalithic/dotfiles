#!/usr/bin/env bash
set -euo pipefail

# PATH: patched lat + pinned helper binaries first, then mise (binary + shims)
# and brew for non-interactive launch contexts (GUI, launchd) that lack shell
# init. ~/.local/bin covers the standalone mise binary itself.
export PATH="$HOME/.pi/agent/bin:$HOME/.local/bin:${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims:/opt/homebrew/bin:$PATH"

resolve_mise() {
  if [ -x "$HOME/.local/bin/mise" ]; then
    printf '%s\n' "$HOME/.local/bin/mise"
    return 0
  fi
  command -v mise
}

mise_bin="$(resolve_mise)" || {
  echo "pi: mise not found" >&2
  exit 127
}

resolve_fnox() {
  local fnox_path
  if fnox_path="$(MISE_AUTO_INSTALL=false "$mise_bin" which fnox 2>/dev/null)" && [ -n "$fnox_path" ]; then
    printf '%s\n' "$fnox_path"
    return 0
  fi
  command -v fnox
}

fnox_bin="$(resolve_fnox)" || {
  echo "pi: fnox not found" >&2
  exit 127
}

resolve_node() {
  local node_path
  if node_path="$(MISE_AUTO_INSTALL=false "$mise_bin" which node 2>/dev/null)" && [ -n "$node_path" ]; then
    printf '%s\n' "$node_path"
    return 0
  fi
  command -v node
}

node_bin="$(resolve_node)" || {
  echo "pi: node not found" >&2
  exit 127
}

explicit_profile=""
user_model=0
user_models=0
pi_args=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --profile)
      if [ "$#" -lt 2 ] || [[ "$2" == --* ]]; then
        echo "pi: --profile requires a profile name" >&2
        exit 2
      fi
      explicit_profile="$2"
      shift 2
      ;;
    --profile=*)
      explicit_profile="${1#--profile=}"
      if [ -z "$explicit_profile" ]; then
        echo "pi: --profile requires a profile name" >&2
        exit 2
      fi
      shift
      ;;
    --model | --model=*)
      user_model=1
      pi_args+=("$1")
      shift
      ;;
    --models | --models=*)
      user_models=1
      pi_args+=("$1")
      shift
      ;;
    *)
      pi_args+=("$1")
      shift
      ;;
  esac
done

resolve_profile=1
case "${pi_args[0]:-}" in
  install | remove | uninstall | update | list | config | auth)
    resolve_profile=0
    ;;
esac
for arg in "${pi_args[@]}"; do
  case "$arg" in
    --help | -h | --version | --list-models | --export)
      resolve_profile=0
      ;;
  esac
done

profile_args=()
if [ "$resolve_profile" -eq 1 ]; then
  profile_session="${PI_SESSION:-}"
  if [ -z "$profile_session" ] && [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
    profile_session="$(tmux display-message -p '#{session_name}' 2>/dev/null || true)"
  fi

  settings_path="$HOME/.pi/agent/settings.json"
  if [ ! -f "$settings_path" ]; then
    settings_path="${DOTFILES_DIR:-$HOME/.dotfiles}/mise/config/pi-coding-agent/agent/settings.json"
  fi
  resolver="${DOTFILES_DIR:-$HOME/.dotfiles}/mise/config/pi-coding-agent/scripts/resolve-profile.mjs"
  resolver_args=(--settings "$settings_path" --cwd "$PWD" --session "$profile_session")
  if [ -n "$explicit_profile" ]; then
    resolver_args+=(--explicit-profile "$explicit_profile")
  fi
  eval "$("$node_bin" "$resolver" "${resolver_args[@]}")"

  if [ "$user_models" -eq 0 ] && [ -z "${PI_SUBAGENT_AGENT:-}" ] && [ -n "${PI_MODEL_SCOPE_PATTERNS:-}" ]; then
    profile_args+=(--models "$PI_MODEL_SCOPE_PATTERNS")
  fi
  if [ "$user_model" -eq 0 ] && [ -n "${PI_SUBAGENT_MODEL:-}" ]; then
    subagent_model="$PI_SUBAGENT_MODEL"
    if [ -n "${PI_SUBAGENT_THINKING:-}" ]; then
      subagent_model+="${subagent_model:+:}$PI_SUBAGENT_THINKING"
    fi
    profile_args+=(--model "$subagent_model")
  fi
fi

export PI_STATE_DIR="${PI_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/pi}"
mkdir -p "$PI_STATE_DIR/sockets" "$PI_STATE_DIR/manifests"
# Generic bridge owns Pi-to-Pi /tell ingress now that pinvim is disabled.
export PI_BRIDGE_LEGACY_SOCKET=1

# Static lat.md semantic-search config. fnox injects LAT_LLM_KEY directly from
# SYNTHETIC_API_KEY via the config alias; the wrapper keeps only non-secret
# provider metadata for GUI or launchd starts.
export LAT_LLM_BASE_URL="https://api.synthetic.new/openai/v1"
export LAT_LLM_MODEL="hf:nomic-ai/nomic-embed-text-v1.5"
export LAT_LLM_DIMENSIONS="768"

# Patch pi-bash-live-view until upstream handles wide glyphs/ANSI truncation.
# Without this, PTY live view can render one cell past terminal width and
# crash Pi. Re-copied on every launch because `pi update` rewrites the file.
bash_live_view_widget="$HOME/.pi/agent/npm/node_modules/pi-bash-live-view/widget.ts"
widget_patch="${DOTFILES_DIR:-$HOME/.dotfiles}/mise/config/pi-coding-agent/patches/pi-bash-live-view/widget.ts"
if [ -f "$bash_live_view_widget" ] && [ -f "$widget_patch" ]; then
  cp "$widget_patch" "$bash_live_view_widget"
fi

# `mise x` prepends the npm tool's own bin dir, so the real pi binary wins
# over this wrapper regardless of PATH ordering. `fnox exec --replace` injects
# secrets without a wrapper re-entry or extra process layer.
exec "$fnox_bin" exec --replace -- "$mise_bin" x "npm:@earendil-works/pi-coding-agent" -- pi "${profile_args[@]}" "${pi_args[@]}"
