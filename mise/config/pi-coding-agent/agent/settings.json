{
	"retry": {
		"baseDelayMs": 1000,
		"maxDelayMs": 900000,
		"provider": {
			"timeoutMs": 3600000
		}
	},
	"warnings": {
		"anthropicExtraUsage": false
	},
	"defaultThinkingLevel": "high",
	"doubleEscapeAction": "tree",
	"enableSkillCommands": true,
	"hideThinkingBlock": true,
	"editorPaddingX": 1,
	"outputPad": 1,
	"quietStartup": true,
	"packages": [
		"npm:pi-mcp-adapter",
		"npm:pi-web-access",
		"npm:pi-caveman",
		"npm:@plannotator/pi-extension",
		"npm:pi-rtk-optimizer",
		"npm:pi-mono-figma",
		"npm:pi-mono-btw",
		"npm:context-mode",
		"npm:pi-elixir",
		"npm:pi-subagents",
		"npm:pi-lens",
		"npm:@ogulcancelik/pi-ssh-tools",
		"npm:@juicesharp/rpiv-ask-user-question",
		"npm:@juicesharp/rpiv-todo",
		"npm:@ff-labs/pi-fff",
		"npm:@hypabolic/pi-hypa",
		"git:github.com/dantetekanem/pi-bash-live-view",
		"~/.local/share/mise/installs/github-nicknisi-fleet/latest/hooks/pi"
	],
	"enabledModels": [
		"anthropic/claude-fable-5",
		"anthropic/claude-opus-5",
		"anthropic/claude-opus-4-8",
		"anthropic/claude-sonnet-5",
		"anthropic/claude-haiku-4-5",
		"openai-codex/gpt-5.6-sol",
		"openai-codex/gpt-5.6-terra",
		"openai-codex/gpt-5.6-luna",
		"openai-codex/gpt-5.5",
		"openai-codex/gpt-5.4",
		"openai-codex/gpt-5.3-codex-spark",
		"google-vertex/gemini-3.1-pro-preview",
		"google-vertex/gemini-3-flash-preview",
		"opencode-go/kimi-k3",
		"opencode-go/deepseek-v4-pro",
		"opencode-go/deepseek-v4-flash",
		"opencode-go/qwen3.7-max",
		"opencode-go/qwen3.7-plus",
		"llamacpp/gemma4",
		"llamacpp/deepseek14b"
	],
	"enabledModelScopes": {
		"mega": [
			"my-codex/gpt-5.6-sol",
			"my-codex/gpt-5.6-terra",
			"my-codex/gpt-5.6-luna",
			"my-codex/gpt-5.5",
			"my-codex/gpt-5.4",
			"my-codex/gpt-5.3-codex-spark",
			"opencode-go/kimi-k3",
			"opencode-go/deepseek-v4-pro",
			"opencode-go/deepseek-v4-flash",
			"opencode-go/qwen3.7-max",
			"opencode-go/qwen3.7-plus",
			"llamacpp/gemma4",
			"llamacpp/deepseek14b"
		],
		"alt": [
			"anthropic/claude-fable-5",
			"anthropic/claude-opus-5",
			"anthropic/claude-opus-4-8",
			"anthropic/claude-sonnet-5",
			"anthropic/claude-haiku-4-5",
			"openai-codex/gpt-5.6-sol",
			"openai-codex/gpt-5.6-terra",
			"openai-codex/gpt-5.6-luna",
			"openai-codex/gpt-5.5",
			"openai-codex/gpt-5.4",
			"openai-codex/gpt-5.3-codex-spark",
			"google-vertex/gemini-3.1-pro-preview",
			"google-vertex/gemini-3-flash-preview",
			"opencode-go/kimi-k3",
			"opencode-go/deepseek-v4-pro",
			"opencode-go/deepseek-v4-flash",
			"opencode-go/qwen3.7-max",
			"opencode-go/qwen3.7-plus"
		]
	},
	"terminal": {
		"showTerminalProgress": true,
		"imageWidthCells": 120
	},
	"shellCommandPrefix": "export GIT_MERGE_AUTOEDIT=no\nGIT_EDITOR=true\nexport GIT_SEQUENCE_EDITOR=true\nexport GIT_TERMINAL_PROMPT=0\nexport PI_TMUX_IMAGES=1",
	"multiSub": {
		"subscriptions": [
			{
				"provider": "anthropic",
				"alias": "anthropic",
				"label": "anthropic"
			},
			{
				"provider": "openai-codex",
				"alias": "my-codex",
				"label": "my-codex"
			}
		],
		"pools": [
			{
				"name": "codex-pool",
				"baseProvider": "my-codex",
				"members": ["openai-codex", "my-codex"],
				"enabled": true
			}
		],
		"chains": [],
		"presets": [
			{
				"name": "mega",
				"entries": [
					{
						"provider": "openai-codex",
						"model": "gpt-5.5",
						"enabled": true
					},
					{
						"provider": "openai-codex",
						"model": "gpt-5.4",
						"enabled": true
					},
					{
						"provider": "openai-codex",
						"model": "gpt-5.4-mini",
						"enabled": true
					}
				],
				"enabled": true
			},
			{
				"name": "alt",
				"entries": [
					{
						"provider": "alt-anthropic",
						"model": "claude-opus-4-8",
						"enabled": true
					},
					{
						"provider": "alt-anthropic",
						"model": "claude-sonnet-5",
						"enabled": true
					},
					{
						"provider": "alt-anthropic",
						"model": "claude-sonnet-4-6",
						"enabled": true
					},
					{
						"provider": "alt-anthropic",
						"model": "claude-haiku-4-5",
						"enabled": true
					},
					{
						"provider": "alt-codex",
						"model": "gpt-5.5",
						"enabled": true
					},
					{
						"provider": "alt-codex",
						"model": "gpt-5.4",
						"enabled": true
					},
					{
						"provider": "alt-codex",
						"model": "gpt-5.4-mini",
						"enabled": true
					}
				],
				"enabled": true
			}
		],
		"directoryProfiles": [
			{
				"glob": "~/code/work/strive/**",
				"preset": "alt",
				"modelScope": "alt"
			}
		]
	},
	"subagents": {
		"agentOverrides": {
			"planner": {
				"model": "anthropic/claude-fable-5",
				"fallbackModels": ["openai-codex/gpt-5.6-sol", "opencode-go/kimi-k3"],
				"thinking": "high"
			},
			"reviewer": {
				"model": "anthropic/claude-fable-5",
				"fallbackModels": ["openai-codex/gpt-5.6-sol", "opencode-go/kimi-k3"],
				"thinking": "high"
			},
			"oracle": {
				"model": "anthropic/claude-fable-5",
				"fallbackModels": ["openai-codex/gpt-5.6-sol", "opencode-go/kimi-k3"],
				"thinking": "high"
			},
			"worker": {
				"model": "anthropic/claude-sonnet-5",
				"fallbackModels": [
					"openai-codex/gpt-5.6-luna",
					"opencode-go/deepseek-v4-flash"
				],
				"thinking": "medium"
			},
			"researcher": {
				"model": "anthropic/claude-sonnet-5",
				"fallbackModels": [
					"openai-codex/gpt-5.6-luna",
					"opencode-go/deepseek-v4-flash"
				],
				"thinking": "medium"
			},
			"scout": {
				"model": "openai-codex/gpt-5.6-luna",
				"fallbackModels": [
					"openai-codex/gpt-5.4-mini",
					"google-vertex/gemini-3-flash-preview",
					"llamacpp/gemma4"
				],
				"thinking": "medium"
			},
			"context-builder": {
				"model": "alt-anthropic/claude-haiku-4-5",
				"fallbackModels": [
					"openai-codex/gpt-5.4-mini",
					"google-vertex/gemini-3-flash-preview",
					"llamacpp/gemma4"
				],
				"thinking": "medium"
			}
		}
	}
}
