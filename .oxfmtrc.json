{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingCommas": "all",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "printWidth": 120,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    "tools/oxlint/**",
    "home/.pi/agent/extensions/_*",
    "home/.pi/agent/skills/_*",
    "home/.pi/agent/prompts/_*",
    "home/.pi/agent/agents/_*",
    "home/.pi/disabled/",
    "home/.pi/patches/",
    "home/.pi/tests/.pidewave-extension-*/"
  ]
}
