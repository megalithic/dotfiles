// Git hooks via hk (https://hk.jdx.dev). Replaces the removed
// devenv/git-hooks.nix setup and replicates its hook set.
//
// Installed globally by `mise run setup:hk`; repos without hk.pkl are no-ops.
// Bypass once enabled: HK=0 git commit ...
amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

local disabledPiEntries = List(
    "home/.pi/agent/extensions/_*",
    "home/.pi/agent/skills/_*",
    "home/.pi/agent/prompts/_*",
    "home/.pi/agent/agents/_*"
)

local tsFiles = List(
    "home/.pi/**/*.ts",
    "home/.pi/**/*.mjs",
    "home/.pi/**/*.js",
    "config/mise/tmpls/elixir/tests/**/*.ts"
)

// Index-wide: rejects force-added or already-tracked files under home/.ssh/
// outside the four deployable sources (see .gitignore).
local sshAllowlistCheck = new CommandSpec {
    command = "mise/scripts/check-ssh-allowlist"
    effect = "read"
}

local linters = new Mapping<String, Step> {
    ["check-added-large-files"] = Builtins.check_added_large_files
    ["check-case-conflict"] = Builtins.check_case_conflict
    ["check-executables-have-shebangs"] = Builtins.check_executables_have_shebangs
    ["check-merge-conflict"] = Builtins.check_merge_conflict
    ["check-shebang-scripts-are-executable"] = Builtins.check_shebang_scripts_are_executable
    ["check-symlinks"] = Builtins.check_symlinks
    ["destroyed-symlinks"] = Builtins.destroyed_symlinks
    ["detect-private-key"] = (Builtins.detect_private_key) {
        // This scanner contains private-key marker regexes as test patterns.
        exclude = List("bin/gatekeeper")
    }
    ["ssh-allowlist"] = new Step {
        glob = List("home/.ssh/**")
        check = sshAllowlistCheck
    }
    // Match the old devenv setup and only scan staged changes.
    ["gitleaks"] = (Builtins.gitleaks) {
        scan = "staged"
    }
    ["shellcheck"] = (Builtins.shellcheck) {
        exclude = disabledPiEntries
        check = new CommandSpec {
            command = "shellcheck --severity=error {{files}}"
            effect = "read"
        }
    }
    ["shfmt"] = (Builtins.shfmt) {
        exclude = disabledPiEntries
    }
    // TS tooling comes from package.json/bun.lock; run `mise run deps:ts` once
    // per clone. Full-tree equivalents: `mise run check:ts`.
    // Oxlint + vendored anti-slop (see tools/oxlint/oxlint.config.ts), staged files only.
    ["oxlint"] = new Step {
        glob = List("home/.pi/**/*.ts", "home/.pi/**/*.mjs", "home/.pi/**/*.js")
        exclude = disabledPiEntries
        check = new CommandSpec {
            command = "node_modules/.bin/oxlint -c tools/oxlint/oxlint.config.ts {{files}}"
            effect = "read"
        }
    }
    // Same scope as `mise run fmt:ts`; .oxfmtrc.json ignores the rest.
    ["oxfmt"] = new Step {
        glob = tsFiles
        exclude = disabledPiEntries
        check = new CommandSpec {
            command = "node_modules/.bin/oxfmt --check --no-error-on-unmatched-pattern {{files}}"
            effect = "read"
        }
        fix = new CommandSpec {
            command = "node_modules/.bin/oxfmt --write --no-error-on-unmatched-pattern {{files}}"
            effect = "write"
        }
    }
    // Nix linters from the old devenv setup — enable once provided by mise:
    // ["deadnix"] = Builtins.deadnix
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["commit-msg"] {
        steps {
            ["check-conventional-commit"] = Builtins.check_conventional_commit
        }
    }
    ["pre-push"] {
        steps {
            ["ssh-allowlist"] {
                check = sshAllowlistCheck
            }
            ["gitleaks-history"] {
                check = new CommandSpec {
                    command = "gitleaks git --redact --no-banner ."
                    effect = "read"
                }
            }
        }
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
